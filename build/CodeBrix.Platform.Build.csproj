<Project Sdk="Microsoft.NET.Sdk">

	<!--
	========================================================================
	CodeBrix.Platform NuGet packaging driver
	========================================================================
	Ported from upstream Uno's build/Uno.UI.Build.csproj, retrofitted with the
	canonical CodeBrix date-stamped versioning scheme.

	This project intentionally compiles nothing of value: its job is to gather
	the ALREADY-BUILT Release outputs of the platform projects and pack them
	into NuGet packages (pack-only model). Build the solution in Release first,
	then build (or run) this project to produce the packages.

	One run computes $(BuildVersion) ONCE and stamps it on every package it
	produces, so a full package build yields a set that all share the same
	version (the single exception is CodeBrix.Platform.SkiaSharp.Views, which
	is pinned to the SkiaSharp version it vendors — its nuspec carries a literal
	<version> rather than the $codebrixversion$ token).

	Packing goes through the .NET SDK packer (via the CodeBrix.Pack.Shim
	project), NOT build\external\nuget\NuGet.exe — that bundled packer is 5.4.0
	(2019) and mis-emits net10.0 dependency groups as ".NETFramework10.0".

	Packages land in:  {repo}\nugets\$(Configuration)\$(BuildVersion)\
	========================================================================
	-->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- This driver is never itself a package. -->
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Nullable>disable</Nullable>
		<!-- This project has no source files; silence the empty-compile warning. -->
		<NoWarn>$(NoWarn);CS2008</NoWarn>
	</PropertyGroup>

	<!--
	Canonical CodeBrix date-stamped version (computed once per build run).
	Format: 1.<years-since-2026>.<dayOfYear>.<minuteOfDay>, all from UTC now.
	This mirrors the canonical version block used in every packable CodeBrix
	.csproj; here it is the single source of truth for the whole pack run.

	OVERRIDE: pass -p:BuildVersion=1.x.y.z to reuse an EXISTING version instead
	of stamping a fresh one. Required when a package must be rebuilt on a second
	machine and stay in the same version-locked set — e.g. the .MacOS package,
	whose native dylib can only be built on Apple Silicon. Building it there with
	-p:BuildVersion=<the Windows run's version> keeps its sibling dependencies
	(aggregate / base runtime / FrameBuffer) pinned to that already-published
	version, so publishing ONLY the rebuilt .MacOS package still restores cleanly.
	(The Condition below makes the date-stamp a fallback; an explicitly supplied
	BuildVersion wins.)
	-->
	<PropertyGroup>
		<_VersionBaseYear>2026</_VersionBaseYear>
		<_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
		<_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
		<_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
		<BuildVersion Condition="'$(BuildVersion)'==''">1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
	</PropertyGroup>

	<PropertyGroup>
		<_RepoRoot>$(MSBuildThisFileDirectory)..\</_RepoRoot>
		<_NuspecDir>$(MSBuildThisFileDirectory)nuget</_NuspecDir>
		<_PackShim>$(MSBuildThisFileDirectory)nuget-pack-shim\CodeBrix.Pack.Shim.csproj</_PackShim>
		<_PackOutputDir>$(_RepoRoot)nugets\$(Configuration)\$(BuildVersion)</_PackOutputDir>

		<!--
		The package dependency gate. See src/Platform.PackageDependencyValidator and
		build/nuget/package-dependency-map.json.

		It runs TWICE in a pack run, for two different jobs:
		  1. before packing, with the emit-properties switch, to generate the $dep_<Package_Id>$ tokens
		     each nuspec uses instead of authoring a version literal;
		  2. after packing, with the package-dir switch, as a HARD GATE over the produced .nupkg files.

		Because PackCodeBrix is the only path that produces packages, step 2 cannot be bypassed:
		no package set can be published without having passed it.
		-->
		<_DependencyValidator>$(_RepoRoot)src\Platform.PackageDependencyValidator\Platform.PackageDependencyValidator.csproj</_DependencyValidator>
		<_DependencyMap>$(_NuspecDir)\package-dependency-map.json</_DependencyMap>
		<_NuspecPropsDir>$(MSBuildThisFileDirectory)obj\nuspec-props</_NuspecPropsDir>
	</PropertyGroup>

	<!--
	The set of nuspec-driven packages produced by this driver. Extend this list
	as packages are migrated. Date-stamped packages use the $codebrixversion$
	token in their <version>; SkiaSharp.Views uses a literal pinned version.
	-->
	<ItemGroup>
		<_Nuspec Include="$(_NuspecDir)\Platform.WinUI.nuspec" />
		<_Nuspec Include="$(_NuspecDir)\Platform.WinUI.Graphics2DSK.nuspec" />
		<_Nuspec Include="$(_NuspecDir)\Platform.WinUI.Graphics3DGL.nuspec" />
		<_Nuspec Include="$(_NuspecDir)\Platform.WinUI.Lottie.nuspec" />
		<_Nuspec Include="$(_NuspecDir)\Platform.WinUI.Svg.nuspec" />
		<_Nuspec Include="$(_NuspecDir)\CodeBrix.Platform.SkiaSharp.Views.nuspec" />
	</ItemGroup>

	<!--
	csproj-packed packages (the head / runtime-host packages). Packed with -p:Version so
	they AND their ProjectReference dependencies (the aggregate, the base Runtime.Skia)
	carry the one shared date-stamped version. Their own GeneratePackageOnBuild is OFF;
	this driver is the sole packer.
	-->
	<ItemGroup>
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia\Platform.UI.Runtime.Skia.csproj" />
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia.Win32\Platform.UI.Runtime.Skia.Win32.csproj" />
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia.Wpf\Platform.UI.Runtime.Skia.Wpf.csproj" />
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia.Linux.FrameBuffer\Platform.UI.Runtime.Skia.Linux.FrameBuffer.csproj" />
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia.Linux.FrameBuffer.Emulated\Platform.UI.Runtime.Skia.Linux.FrameBuffer.Emulated.csproj" />
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia.MacOS\Platform.UI.Runtime.Skia.MacOS.csproj" />
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia.X11\Platform.UI.Runtime.Skia.X11.csproj" />
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\Platform.UI.Runtime.Skia.Wayland\Platform.UI.Runtime.Skia.Wayland.csproj" />

		<!-- The WebView AddIn (CodeBrix.Platform.WebView.ApacheLicenseForever) ships with every
		     family release. (The legacy Platform.UI.WebView.Skia.X11 AddIn is deliberately NOT
		     listed - it is unsupported, slated for deletion, and must never be published.) -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.WebView.Skia\Platform.UI.WebView.Skia.csproj" />

		<!-- The AudioPlayer AddIn (CodeBrix.Platform.AudioPlayer.ApacheLicenseForever) ships with every
		     family release: the XAML-declarable AudioPlayer and MidiPlayer elements and the
		     fire-and-forget SoundEffect class, backed by the CodeBrix.Audio.MitLicenseForever nuget
		     (fully managed WAV/MP3/Ogg Vorbis/FLAC plus SoundFont and SFZ synthesis, with a bundled
		     miniaudio device backend), live on all six heads including macOS. -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.AudioPlayer.Skia\Platform.UI.AudioPlayer.Skia.csproj" />

		<!-- The VideoPlayer AddIn (CodeBrix.Platform.VideoPlayer.ApacheLicenseForever) ships with every
		     family release: the XAML-declarable VideoPlayer element, backed by the
		     CodeBrix.VideoPlayback.MitLicenseForever nuget (managed WebM/Matroska and .cbv reading,
		     demultiplexing, A/V sync, and the drawing-free rendering vocabulary), live on all six
		     heads including macOS. The composing presenter and its colour shader are the add-in's
		     OWN code (Internal/VideoPresenter.cs), compiled against the family's SkiaSharp pin: the
		     engine's companion CodeBrix.VideoPlayback.Skia package pins its own SkiaSharp, and this
		     family ships one SkiaSharp for everything, so that package must never become a
		     dependency here. It ALSO ProjectReferences the
		     Graphics3DGL AddIn - the first add-in to add-in reference in this repository - which is
		     what gives it the off-screen GPU Skia context (SkiaGpuContext) with no wiring in the
		     consuming application; that reference packs as a dependency on
		     CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever at the family version, which is why
		     Graphics3DGL's PackageId had to become its PUBLISHED id (see its csproj). AV1 decoding
		     (Dav1d, BSD-2) and Opus (BSD-3) are deliberately NOT dependencies - the application
		     references and registers those itself. -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.VideoPlayer.Skia\Platform.UI.VideoPlayer.Skia.csproj" />

		<!-- The MediaPlayer AddIn (CodeBrix.Platform.MediaPlayer.LgplLicenseForever) ships with every
		     family release: one windowing-agnostic vmem package for the Win32, WPF, X11, Wayland, and
		     FrameBuffer heads (macOS uses its built-in AVFoundation support). (The legacy
		     Platform.UI.MediaPlayer.Skia.X11 / .Win32 AddIns are deliberately NOT listed - they use
		     native child-window embedding, are superseded by this AddIn, and must never be published.) -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.MediaPlayer.Skia\Platform.UI.MediaPlayer.Skia.csproj" />

		<!-- The TextLayout AddIn (CodeBrix.Platform.TextLayout.ApacheLicenseForever) ships with every
		     family release: a host-free, XAML-free façade over the very same text engine that lays out
		     every TextBlock in the framework. It exposes shaping, bidi, caret and cluster geometry,
		     selection rectangles, glyph outline paths, and drawing into an arbitrary SKCanvas, for
		     consumers that need Pango-class text without a visual tree. -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.TextLayout\Platform.UI.TextLayout.Skia.csproj" />

		<!-- The FlexPanel AddIn (CodeBrix.Platform.FlexPanel.ApacheLicenseForever) ships with every
		     family release: a CSS flexbox-style XAML layout panel (Direction / JustifyContent /
		     AlignItems / AlignContent / Wrap plus the attached Grow, Shrink, Basis, Order and
		     AlignSelf properties), driven by a managed port of the .NET MAUI FlexLayout engine.
		     Pure layout - no native dependencies. -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.FlexPanel\Platform.UI.FlexPanel.Skia.csproj" />

		<!-- The AdvancedTextEdit AddIn (CodeBrix.Platform.AdvancedTextEdit.ApacheLicenseForever)
		     ships with every family release: a full code/text editor XAML control - rope-backed
		     document with anchors and grouped undo/redo, XSHD syntax highlighting with built-in
		     definitions, code folding, completion popup, search panel, snippets, indentation,
		     line numbers, word wrap, rectangular selection, and virtualized rendering - laid out
		     by the family's single text engine via the TextLayout AddIn (which packs as a
		     package dependency). -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.AdvancedTextEdit\Platform.UI.AdvancedTextEdit.Skia.csproj" />

		<!-- The TerminalView AddIn (CodeBrix.Platform.TerminalView.ApacheLicenseForever) ships with
		     every family release: a terminal emulator XAML control rendering a CodeBrix.Terminal
		     engine (the CodeBrix fork of XtermSharp) on a Skia surface - transport-agnostic (feed
		     bytes/text in, VT-encoded input out), with ANSI/256-color attributes, scrollback with
		     scrollbar/wheel/keys, selection, clipboard copy/paste, grid resize reporting for PTY
		     window-change requests, and keyboard encoding via the engine's TerminalKeyEncoder.
		     Text is laid out by the family's single text engine via the TextLayout AddIn (which
		     packs as a package dependency and carries the ICU Unicode packages); the engine and
		     default Roboto Mono font come in as versioned package dependencies. -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.TerminalView\Platform.UI.TerminalView.Skia.csproj" />

		<!-- The PlotterView AddIn (CodeBrix.Platform.PlotterView.ApacheLicenseForever) ships with
		     every family release: a chart XAML control hosting a CodeBrix.Plotter PlotModel (the
		     CodeBrix port of OxyPlot) on a Skia surface, with the library's full interaction model
		     wired in - pan/zoom/tracker/zoom-rectangle/reset from mouse, keyboard and touch
		     (single-finger pan, two-finger pinch). All chart text resolves through the
		     application's own fonts via the framework's FontDetailsCache (never system fonts);
		     the plotting engine comes in as a versioned package dependency. Unlike the text
		     add-ins there is no TextLayout dependency - the engine shapes its own text through
		     SkiaSharp.HarfBuzz. -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.UI.PlotterView\Platform.UI.PlotterView.Skia.csproj" />

		<!-- The AppSettings AddIn (CodeBrix.Platform.AppSettings.ApacheLicenseForever) ships with
		     every family release, and is the first AddIn that is not a UI control: an application
		     settings system storing JSON values in a single portable settings.sqlite, with a
		     startup auto-backup and retention pruning, quarantine-and-restore of a corrupt file,
		     and validated export/import. The SQLite engine comes in as a versioned package
		     dependency. It references the framework only so a consumer has the assembly carrying
		     LogExtensionPoint (every consumer is a CodeBrix.Platform application already), plus
		     Microsoft.Extensions.Logging.Abstractions, which must flow PUBLICLY - the private
		     Extensions.Logging project reference does not carry it to consumers. -->
		<_CsprojPackage Include="$(MSBuildThisFileDirectory)..\src\AddIns\Platform.AppSettings\Platform.AppSettings.csproj" />
	</ItemGroup>

	<Target Name="PackCodeBrix"
			AfterTargets="Build"
			Condition="'$(Configuration)'=='Release'">

		<!-- Capture git branch/commit for the nuspec <repository> tokens. -->
		<Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" WorkingDirectory="$(_RepoRoot)">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitBranch" />
		</Exec>
		<Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" WorkingDirectory="$(_RepoRoot)">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
		</Exec>
		<PropertyGroup>
			<_GitBranch Condition="'$(_GitBranch)'==''">unknown</_GitBranch>
			<_GitCommit Condition="'$(_GitCommit)'==''">unknown</_GitCommit>
		</PropertyGroup>

		<MakeDir Directories="$(_PackOutputDir)" />

		<Message Importance="high" Text="CodeBrix pack: version $(BuildVersion) -> $(_PackOutputDir)" />

		<!--
		Generate the pack-time dependency version tokens from the packed projects' own
		PackageReferences. This is what lets every nuspec name a token instead of a version, so the
		.csproj (the view Visual Studio's Solution NuGet package view manages) stays the single
		authority. Evaluation only - no restore, no build, no network.
		-->
		<Message Importance="high" Text="CodeBrix pack: generating nuspec dependency tokens" />
		<Exec Command="dotnet run --project &quot;$(_DependencyValidator)&quot; -c Release --nologo -- --map &quot;$(_DependencyMap)&quot; --repo-root &quot;$(_RepoRoot).&quot; --emit-properties &quot;$(_NuspecPropsDir)&quot; --no-fail" />

		<!-- Pack each nuspec through the SDK packer (net10.0-aware). One Exec per
		     nuspec; the shim turns the -p: values into NuspecFile/NuspecProperties. -->
		<Exec Command="dotnet pack &quot;$(_PackShim)&quot; -p:CbxNuspec=&quot;%(_Nuspec.Identity)&quot; -p:CbxNuspecBasePath=&quot;$(_NuspecDir)&quot; -p:CbxVersion=$(BuildVersion) -p:CbxBranch=$(_GitBranch) -p:CbxCommit=$(_GitCommit) -p:CbxNuspecPropsFile=&quot;$(_NuspecPropsDir)\%(_Nuspec.Filename).props&quot; --output &quot;$(_PackOutputDir)&quot; --nologo --verbosity minimal" />

		<!-- Pack the csproj-based head/runtime packages with the shared date-stamped PACKAGE
		     version only. We must NOT pass -p:Version here: that would override the platform's
		     stable <Version>255.255.255.255</Version> (Directory.Build.props) and bump the
		     AssemblyVersion of every project in the head's build graph, while folded-but-
		     unreferenced assemblies (e.g. the logging Adapter) stay at 255.255.255.255 — a skew
		     that breaks runtime assembly binding. -p:PackageVersion sets only the NuGet package
		     version and still flows to the ProjectReference dependency versions. -->
		<Exec Command="dotnet pack &quot;%(_CsprojPackage.Identity)&quot; -c Release -p:PackageVersion=$(BuildVersion) --output &quot;$(_PackOutputDir)&quot; --nologo --verbosity minimal" />

		<!--
		THE GATE. Verifies every produced nuspec-driven package against the project(s) it packs:
		a package may never declare a dependency version different from the PackageReference
		version chosen in the .csproj, may not omit a dependency a packed project references, and
		must agree with the SkiaSharp / HarfBuzzSharp hard lock. A failure here fails the pack, so
		a mismatched package set can never reach nuget.org.

		This does NOT check whether any version is the newest available - choosing versions is the
		maintainer's job, done in Visual Studio. The gate never contacts a package feed.
		-->
		<Message Importance="high" Text="CodeBrix pack: verifying package dependencies" />
		<Exec Command="dotnet run --project &quot;$(_DependencyValidator)&quot; -c Release --nologo -- --map &quot;$(_DependencyMap)&quot; --repo-root &quot;$(_RepoRoot).&quot; --package-dir &quot;$(_PackOutputDir)&quot;" />

	</Target>

</Project>
