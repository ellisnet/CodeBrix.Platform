		<file src="..\..\src\Platform.UI.Toolkit\bin\Platform.UI.Toolkit.Core\Release\net10.0\CodeBrix.Platform.UI.Toolkit.Core.pdb" target="codebrix-platform-runtime\net10.0\skia" />

		<!-- Folded-in: Foundation (Core by whole), WinRT (Platform), Dispatching, Foundation.Logging (Core by whole) -->
		<file src="..\..\src\Platform.Foundation\bin\Platform.Foundation.Core\Release\net10.0\CodeBrix.Platform.Foundation.Core.dll" target="codebrix-platform-runtime\net10.0\skia" />
