		<!-- The Core assemblies of the split libraries, beside their Skia twins: runtime-replace swaps EVERY runtime
		     assembly of this package for the content of this folder, so an assembly that is only in lib/ would be
		     missing from the application's output. Byte-identical to the lib/ copies. -->
		<file src="..\..\src\Platform.UI\bin\Platform.UI.Core\Release\net10.0\CodeBrix.Platform.UI.Core.dll" target="codebrix-platform-runtime\net10.0\skia" />
