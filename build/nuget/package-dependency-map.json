{
	// ====================================================================
	// CodeBrix.Platform package dependency map
	// ====================================================================
	// Consumed by src/Platform.PackageDependencyValidator, which the packaging driver
	// (build/CodeBrix.Platform.Build.csproj) runs as a hard gate.
	//
	// THE RULE THIS ENFORCES
	//   A .nuspec may never state a dependency version that differs from the PackageReference
	//   version of the project(s) it packs. Versions flow ONE WAY: .csproj -> .nuspec.
	//   Choosing versions is the maintainer's job, done in Visual Studio's Solution NuGet
	//   package view. This gate never contacts nuget.org and never judges whether a version
	//   is up to date.
	//
	// Only the nuspec-driven packages appear here. The csproj-packed packages (the heads,
	// Runtime.Skia, WebView, AudioPlayer, MediaPlayer, TextLayout, FlexPanel) have their
	// dependencies generated by the SDK packer from their own PackageReferences and therefore
	// cannot drift.
	// ====================================================================

	// --------------------------------------------------------------------
	// HARD GUARDRAIL: CodeBrix.Platform.SkiaSharp.Views is never inspected.
	// That package is special and is published only very rarely; nothing about its content
	// or its build may change. It would pass this gate, but "would pass" is not a guarantee —
	// excluded, it can never be the reason a build fails.
	// --------------------------------------------------------------------
	"excludedPackages": [
		"CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever"
	],

	// --------------------------------------------------------------------
	// The family-wide hard lock. Every part of CodeBrix.Platform depends on these, so every
	// packed project must resolve the SAME version of each. The consumer-side half of this lock
	// lives in platform.winui.common.targets (UNOB0002 / UNOB0003).
	//
	// Currently locked to SkiaSharp 4.151.0 / HarfBuzzSharp 14.2.1.1. A newer SkiaSharp must NOT
	// be adopted by any CodeBrix library or application until the CodeBrix.Platform packages have
	// been tested and updated against it.
	// --------------------------------------------------------------------
	"lockedPackages": [
		"SkiaSharp",
		"SkiaSharp.HarfBuzz",
		"SkiaSharp.Skottie",
		"SkiaSharp.NativeAssets.Linux",
		"SkiaSharp.NativeAssets.macos",
		"SkiaSharp.NativeAssets.Win32",
		"HarfBuzzSharp",
		"HarfBuzzSharp.NativeAssets.Linux",
		"HarfBuzzSharp.NativeAssets.macOS",
		"HarfBuzzSharp.NativeAssets.Win32"
	],

	// --------------------------------------------------------------------
	// The consumer-side half of the hard lock. platform.winui.common.props ships in the core
	// package's buildTransitive and tells consuming applications which versions are required
	// (enforced there by UNOB0002 / UNOB0003). The gate asserts these literals always equal the
	// version the packed projects actually resolve, so the lock can never go stale and start
	// rejecting the very version CodeBrix.Platform ships against.
	// --------------------------------------------------------------------
	"lockDeclaration": {
		"file": "platform.winui.common.props",
		"properties": {
			"SkiaSharp": "CodeBrixRequiredSkiaSharpVersion",
			"HarfBuzzSharp": "CodeBrixRequiredHarfBuzzSharpVersion"
		}
	},

	// --------------------------------------------------------------------
	// Which package each project ships in.
	//
	// A ProjectReference to a project that ships in a DIFFERENT package is a real package
	// dependency, but a PackageReference-based check cannot see it — that is exactly how the Svg
	// and Lottie packages came to bind Graphics2DSK without declaring it. This map closes that
	// hole. Only EXISTENCE is checked for these, never the version: family packages are stamped at
	// pack time from the shared $codebrixversion$ token, so no independently authored version
	// exists to disagree with.
	//
	// A ProjectReference to a project listed here as belonging to the SAME package is folded-in,
	// not a dependency, and is ignored. A ProjectReference to a project missing from this map
	// produces a warning, so the map cannot silently go stale.
	//
	// References carrying PrivateAssets=all or ReferenceOutputAssembly=false are excluded before
	// lookup — ordinary NuGet semantics for "deliberately does not flow".
	// --------------------------------------------------------------------
	"projectPackages": {
		"src/Platform.UI/Platform.UI.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI/Platform.UI.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.Composition/Platform.UI.Composition.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.Composition/Platform.UI.Composition.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.FluentTheme/Platform.UI.FluentTheme.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.FluentTheme/Platform.UI.FluentTheme.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.FluentTheme.v1/Platform.UI.FluentTheme.v1.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.FluentTheme.v1/Platform.UI.FluentTheme.v1.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.FluentTheme.v2/Platform.UI.FluentTheme.v2.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.FluentTheme.v2/Platform.UI.FluentTheme.v2.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.Toolkit/Platform.UI.Toolkit.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.Toolkit/Platform.UI.Toolkit.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.Foundation/Platform.Foundation.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.Foundation/Platform.Foundation.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.Foundation/Platform.Foundation.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UWP/Platform.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UWP/Platform.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.Dispatching/Platform.UI.Dispatching.Reference.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.Dispatching/Platform.UI.Dispatching.Skia.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.Foundation.Logging/Platform.Foundation.Logging.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/Platform.UI.Adapter.Microsoft.Extensions.Logging/Platform.UI.Adapter.Microsoft.Extensions.Logging.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/CodeBrix.Platform.Extensions.Logging/CodeBrix.Platform.Extensions.Logging.csproj": "CodeBrix.Platform.ApacheLicenseForever",
		"src/SourceGenerators/System.Xaml/Platform.Xaml.csproj": "CodeBrix.Platform.ApacheLicenseForever",

		"src/AddIns/CodeBrix.Platform.SkiaSharp.Views/CodeBrix.Platform.SkiaSharp.Views.Reference.csproj": "CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever",
		"src/AddIns/CodeBrix.Platform.SkiaSharp.Views/CodeBrix.Platform.SkiaSharp.Views.Skia.csproj": "CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever",
		"src/AddIns/Platform.WinUI.Graphics2DSK/Platform.WinUI.Graphics2DSK.Crossruntime.csproj": "CodeBrix.Platform.Graphics2DSK.ApacheLicenseForever",
		"src/AddIns/Platform.WinUI.Graphics3DGL/Platform.WinUI.Graphics3DGL.csproj": "CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever",
		"src/AddIns/Platform.UI.Lottie/Platform.UI.Lottie.Reference.csproj": "CodeBrix.Platform.Lottie.ApacheLicenseForever",
		"src/AddIns/Platform.UI.Lottie/Platform.UI.Lottie.Skia.csproj": "CodeBrix.Platform.Lottie.ApacheLicenseForever",
		"src/AddIns/Platform.UI.Svg/Platform.UI.Svg.Reference.csproj": "CodeBrix.Platform.Svg.ApacheLicenseForever",
		"src/AddIns/Platform.UI.Svg/Platform.UI.Svg.Skia.csproj": "CodeBrix.Platform.Svg.ApacheLicenseForever"
	},

	"packages": [
		{
			"packageId": "CodeBrix.Platform.ApacheLicenseForever",
			"nuspec": "Platform.WinUI.nuspec",
			"projects": [
				"src/Platform.UI/Platform.UI.Reference.csproj",
				"src/Platform.UI/Platform.UI.Skia.csproj",
				"src/Platform.UI.Composition/Platform.UI.Composition.Reference.csproj",
				"src/Platform.UI.Composition/Platform.UI.Composition.Skia.csproj",
				"src/Platform.UI.FluentTheme/Platform.UI.FluentTheme.Reference.csproj",
				"src/Platform.UI.FluentTheme/Platform.UI.FluentTheme.Skia.csproj",
				"src/Platform.UI.FluentTheme.v1/Platform.UI.FluentTheme.v1.Reference.csproj",
				"src/Platform.UI.FluentTheme.v1/Platform.UI.FluentTheme.v1.Skia.csproj",
				"src/Platform.UI.FluentTheme.v2/Platform.UI.FluentTheme.v2.Reference.csproj",
				"src/Platform.UI.FluentTheme.v2/Platform.UI.FluentTheme.v2.Skia.csproj",
				"src/Platform.UI.Toolkit/Platform.UI.Toolkit.Reference.csproj",
				"src/Platform.UI.Toolkit/Platform.UI.Toolkit.Skia.csproj",
				"src/Platform.Foundation/Platform.Foundation.Reference.csproj",
				"src/Platform.Foundation/Platform.Foundation.Skia.csproj",
				"src/Platform.UWP/Platform.Reference.csproj",
				"src/Platform.UWP/Platform.Skia.csproj",
				"src/Platform.UI.Dispatching/Platform.UI.Dispatching.Reference.csproj",
				"src/Platform.UI.Dispatching/Platform.UI.Dispatching.Skia.csproj",
				"src/Platform.Foundation.Logging/Platform.Foundation.Logging.csproj",
				"src/Platform.UI.Adapter.Microsoft.Extensions.Logging/Platform.UI.Adapter.Microsoft.Extensions.Logging.csproj",
				"src/CodeBrix.Platform.Extensions.Logging/CodeBrix.Platform.Extensions.Logging.csproj",
				"src/SourceGenerators/System.Xaml/Platform.Xaml.csproj"
			],
			// Fonts.Fluent is not a PackageReference of any packed project; the core package
			// declares it deliberately so every consumer gets the Fluent theme's icon font.
			"allowedExtraDependencies": [
				"CodeBrix.Platform.Fonts.Fluent.ApacheLicenseForever"
			],
			// SkiaSharp / HarfBuzzSharp reach the app through the platform HEAD package
			// (Runtime.Skia.X11 / .Wayland / .Win32 / .Wpf / .MacOS / .FrameBuffer), each of which
			// declares them explicitly. The core package deliberately does not, so that the head
			// remains the single place the Skia stack is pulled in.
			// NOTE: revisit only as a deliberate, separately-approved change — these ids are
			// under the family hard lock.
			"allowedMissingDependencies": [
				"SkiaSharp",
				"SkiaSharp.HarfBuzz",
				"HarfBuzzSharp"
			]
		},
		{
			"packageId": "CodeBrix.Platform.Graphics2DSK.ApacheLicenseForever",
			"nuspec": "Platform.WinUI.Graphics2DSK.nuspec",
			"projects": [
				"src/AddIns/Platform.WinUI.Graphics2DSK/Platform.WinUI.Graphics2DSK.Crossruntime.csproj"
			],
			"allowedExtraDependencies": [],
			"allowedMissingDependencies": []
		},
		{
			"packageId": "CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever",
			"nuspec": "Platform.WinUI.Graphics3DGL.nuspec",
			"projects": [
				"src/AddIns/Platform.WinUI.Graphics3DGL/Platform.WinUI.Graphics3DGL.csproj"
			],
			"allowedExtraDependencies": [],
			"allowedMissingDependencies": []
		},
		{
			"packageId": "CodeBrix.Platform.Lottie.ApacheLicenseForever",
			"nuspec": "Platform.WinUI.Lottie.nuspec",
			"projects": [
				"src/AddIns/Platform.UI.Lottie/Platform.UI.Lottie.Reference.csproj",
				"src/AddIns/Platform.UI.Lottie/Platform.UI.Lottie.Skia.csproj"
			],
			// Nothing to allow: every dependency this nuspec declares is now backed either by a
			// PackageReference or by a ProjectReference resolved through projectPackages above.
			"allowedExtraDependencies": [],
			// Referenced by Platform.UI.Lottie.Reference.csproj but not bound by any shipped
			// assembly, so it is not a real dependency of the package. Flagged in the audit as a
			// csproj cleanup candidate, deliberately not actioned here.
			"allowedMissingDependencies": [
				"Newtonsoft.Json"
			]
		},
		{
			"packageId": "CodeBrix.Platform.Svg.ApacheLicenseForever",
			"nuspec": "Platform.WinUI.Svg.nuspec",
			"projects": [
				"src/AddIns/Platform.UI.Svg/Platform.UI.Svg.Reference.csproj",
				"src/AddIns/Platform.UI.Svg/Platform.UI.Svg.Skia.csproj"
			],
			// Same ProjectReference-sourced pair as Lottie, above.
			"allowedExtraDependencies": [
				"CodeBrix.Platform.ApacheLicenseForever",
				"CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever"
			],
			"allowedMissingDependencies": []
		}
	]
}
