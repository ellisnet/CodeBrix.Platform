<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<metadata minClientVersion="5.0">
		<id>CodeBrix.Platform.Svg.ApacheLicenseForever</id>
		<version>$codebrixversion$</version>
		<title>CodeBrix.Platform.Svg</title>
		<authors>Jeremy Ellis and contributors</authors>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<projectUrl>https://github.com/ellisnet/CodeBrix.Platform</projectUrl>
		<license type="expression">Apache-2.0</license>
		<icon>icon-codebrix-128.png</icon>
		<readme>README.md</readme>
		<description>
			SVG rendering support (SvgImageSource on Skia targets) for CodeBrix.Platform applications.
		</description>
		<copyright>Copyright (c) 2026 Jeremy Ellis and contributors</copyright>
		<tags>svg;vector-graphics;skia;rendering;CodeBrix</tags>
		<repository type="git" url="https://github.com/ellisnet/CodeBrix.Platform.git" branch="$branch$" commit="$commitid$" />

		<dependencies>
			<group targetFramework="net10.0">
				<dependency id="CodeBrix.Platform.ApacheLicenseForever" version="$codebrixversion$" />
				<dependency id="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" version="4.152.0" />
				<!-- Stamped with the shared family version at pack time. (The SVG element drew on Graphics2DSK's
				     SKCanvasElement before the Core/Skia split; it now draws on the SkiaSharp views add-in's
				     canvas host. The dependency is kept, unchanged, with the package's dependency set.) -->
				<dependency id="CodeBrix.Platform.Graphics2DSK.ApacheLicenseForever" version="$codebrixversion$" />
				<!-- Version comes from this add-in's own PackageReference at pack time; never authored here. -->
				<dependency id="CodeBrix.SkiaSvg.MitLicenseForever" version="$dep_CodeBrix_SkiaSvg_MitLicenseForever$" />
			</group>

		</dependencies>

		<references>
			<group targetFramework="net10.0">
				<reference file="CodeBrix.Platform.UI.Svg.Core.dll" />
				<reference file="CodeBrix.Platform.UI.Svg.dll" />
			</group>
		</references>
	</metadata>
	<files>
		<file src="..\..\icon-codebrix-128.png" target="/" />
		<file src="..\..\README.md" target="/" />
		<file src="..\..\src\AddIns\Platform.UI.Svg\AGENT-README.txt" target="/" />
		<file src="..\..\THIRD-PARTY-NOTICES.txt" target="/" />
		<!-- Compile-time assemblies: the Core assembly (SvgProvider and the drawing) and the Skia assembly, whose
		     [assembly: ApiExtension] an application's XAML source generator must see to register SvgProvider. -->
		<file src="..\..\src\AddIns\Platform.UI.Svg\bin\Platform.UI.Svg.Core\Release\net10.0\CodeBrix.Platform.UI.Svg.Core.dll" target="lib\net10.0" />
		<file src="..\..\src\AddIns\Platform.UI.Svg\bin\Platform.UI.Svg.Core\Release\net10.0\CodeBrix.Platform.UI.Svg.Core.pdb" target="lib\net10.0" />
		<file src="..\..\src\AddIns\Platform.UI.Svg\bin\Platform.UI.Svg.Skia\Release\net10.0\CodeBrix.Platform.UI.Svg.dll" target="lib\net10.0" />

		<!-- Build targets (renamed to <PackageId>.targets so NuGet auto-imports it). -->
		<file src="..\..\src\AddIns\Platform.UI.Svg\buildTransitive\Platform.WinUI.Svg.targets" target="buildTransitive\CodeBrix.Platform.Svg.ApacheLicenseForever.targets" />

		<!-- net10.0 Skia -->
		<file src="..\..\src\AddIns\Platform.UI.Svg\bin\Platform.UI.Svg.Skia\Release\net10.0\CodeBrix.Platform.UI.Svg.*" exclude="..\..\src\AddIns\Platform.UI.Svg\bin\Platform.UI.Svg.Skia\Release\net10.0\CodeBrix.Platform.UI.Svg.Core.*" target="codebrix-platform-runtime\net10.0\skia" />
		<!-- The runtime selection replaces the package's copy-local assemblies with this folder's, so the Core
		     assembly must be here too. -->
		<file src="..\..\src\AddIns\Platform.UI.Svg\bin\Platform.UI.Svg.Core\Release\net10.0\CodeBrix.Platform.UI.Svg.Core.dll" target="codebrix-platform-runtime\net10.0\skia" />
		<file src="..\..\src\AddIns\Platform.UI.Svg\bin\Platform.UI.Svg.Core\Release\net10.0\CodeBrix.Platform.UI.Svg.Core.pdb" target="codebrix-platform-runtime\net10.0\skia" />

	</files>
</package>
