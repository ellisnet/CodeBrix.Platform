<Project Sdk="Microsoft.NET.Sdk">

	<!--
	The host-free Core proof (plan gate G6): this suite references ONLY the platform-neutral Core assemblies
	(CodeBrix.Platform.UI.Core and what it references - no Skia assembly, no SkiaSharp/HarfBuzz package), builds
	XAML elements, a Page with bindings and styles, navigates a Frame, and asserts that no SkiaSharp assembly was
	loaded into the process. It is the readiness proof for a non-Skia platform (CodeBrix.Android, CodeBrix.Mobile):
	whatever platform contract the Core path needs, a test double registers here, as such a platform would.
	-->
	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>

		<!-- xUnit.net v3 test projects are self-executing binaries and must build as Exe;
		     run via Microsoft.Testing.Platform, matching the CodeBrix family test convention. -->
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

		<AssemblyName>CodeBrix.Platform.UI.Core.Tests</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.Core.Tests</RootNamespace>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
	</ItemGroup>

	<ItemGroup>
		<!-- The Core assemblies only. Nothing in this graph references a Skia project. -->
		<ProjectReference Include="..\Platform.UI\Platform.UI.Core.csproj" />
		<!-- The add-ins' Core assemblies (Phase C), each proven host-free by AddInCoreTests. -->
		<ProjectReference Include="..\AddIns\Platform.UI.FlexPanel\Platform.UI.FlexPanel.Core.csproj" />
		<ProjectReference Include="..\AddIns\Platform.UI.CommandBar\Platform.UI.CommandBar.Core.csproj" />
		<ProjectReference Include="..\AddIns\Platform.AppSettings\Platform.AppSettings.Core.csproj" />
		<ProjectReference Include="..\AddIns\Platform.UI.AudioPlayer.Skia\Platform.UI.AudioPlayer.Core.csproj" />
		<ProjectReference Include="..\AddIns\Platform.WinUI.Graphics3DGL\Platform.WinUI.Graphics3DGL.Core.csproj" />
		<ProjectReference Include="..\AddIns\Platform.UI.VideoPlayer.Skia\Platform.UI.VideoPlayer.Core.csproj" />
	</ItemGroup>

	<!-- The Skia-canvas add-ins' Core assemblies (plan rule R7: they reference SkiaSharp, but no Skia assembly of the
	     platform). They are built first but NOT referenced - neither their assemblies nor their packages - so this
	     graph stays free of SkiaSharp; AddInCoreTests reads each one's metadata from the path given below. -->
	<ItemGroup>
		<ProjectReference Include="..\AddIns\CodeBrix.Platform.SkiaSharp.Views\CodeBrix.Platform.SkiaSharp.Views.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
		<ProjectReference Include="..\AddIns\Platform.WinUI.Graphics2DSK\Platform.WinUI.Graphics2DSK.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
		<ProjectReference Include="..\AddIns\Platform.UI.Svg\Platform.UI.Svg.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
		<ProjectReference Include="..\AddIns\Platform.UI.Lottie\Platform.UI.Lottie.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
		<ProjectReference Include="..\AddIns\Platform.UI.TextLayout\Platform.UI.TextLayout.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
		<ProjectReference Include="..\AddIns\Platform.UI.AdvancedTextEdit\Platform.UI.AdvancedTextEdit.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
		<ProjectReference Include="..\AddIns\Platform.UI.TerminalView\Platform.UI.TerminalView.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
		<ProjectReference Include="..\AddIns\Platform.UI.PlotterView\Platform.UI.PlotterView.Core.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />

		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>R7Core:CodeBrix.Platform.SkiaSharp.Views.Core</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)../AddIns/CodeBrix.Platform.SkiaSharp.Views/bin/CodeBrix.Platform.SkiaSharp.Views.Core/$(Configuration)/net10.0/CodeBrix.Platform.SkiaSharp.Views.Core.dll</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>R7Core:CodeBrix.Platform.WinUI.Graphics2DSK.Core</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)../AddIns/Platform.WinUI.Graphics2DSK/bin/Platform.WinUI.Graphics2DSK.Core/$(Configuration)/net10.0/CodeBrix.Platform.WinUI.Graphics2DSK.Core.dll</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>R7Core:CodeBrix.Platform.UI.Svg.Core</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)../AddIns/Platform.UI.Svg/bin/Platform.UI.Svg.Core/$(Configuration)/net10.0/CodeBrix.Platform.UI.Svg.Core.dll</_Parameter2>
