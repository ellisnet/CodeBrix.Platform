		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>R7Core:CodeBrix.Platform.UI.TextLayout.Core</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)../AddIns/Platform.UI.TextLayout/bin/Platform.UI.TextLayout.Core/$(Configuration)/net10.0/CodeBrix.Platform.UI.TextLayout.Core.dll</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>R7Core:CodeBrix.Platform.UI.AdvancedTextEdit.Core</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)../AddIns/Platform.UI.AdvancedTextEdit/bin/Platform.UI.AdvancedTextEdit.Core/$(Configuration)/net10.0/CodeBrix.Platform.UI.AdvancedTextEdit.Core.dll</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>R7Core:CodeBrix.Platform.UI.TerminalView.Core</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)../AddIns/Platform.UI.TerminalView/bin/Platform.UI.TerminalView.Core/$(Configuration)/net10.0/CodeBrix.Platform.UI.TerminalView.Core.dll</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>R7Core:CodeBrix.Platform.UI.PlotterView.Core</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)../AddIns/Platform.UI.PlotterView/bin/Platform.UI.PlotterView.Core/$(Configuration)/net10.0/CodeBrix.Platform.UI.PlotterView.Core.dll</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Phase D (G6, WPD D2): EVERY Core assembly the family produces - the framework's twelve and the add-ins' fourteen -
