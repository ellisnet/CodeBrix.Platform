<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>

		<!-- xUnit.net v3 test projects are self-executing binaries and must build as Exe;
		     run via Microsoft.Testing.Platform, matching the CodeBrix family test convention. -->
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

		<AssemblyName>CodeBrix.Platform.PlayTest.WebGpu.Tests</AssemblyName>
		<RootNamespace>CodeBrix.Platform.PlayTest.WebGpu.Tests</RootNamespace>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>

		<!-- No application is launched here (that is WebGpuDemo's PlayTests, one application per process): the
		     provider is driven through the head's own launch-time WebGPU setup - plan, probe, gate - with the real
		     device route, and the gate it produces is handed to the WebGpu view's own gate evaluation. The GPU tests
		     skip with the engine's reason where no adapter exists. -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI.Runtime.Skia.PlayTest.WebGpu\Platform.UI.Runtime.Skia.PlayTest.WebGpu.csproj" />
		<!-- The package references the head privately (a consumer's test project always references the head
		     itself), so this suite does too, exactly as a consumer would. -->
		<ProjectReference Include="..\Platform.UI.Runtime.Skia.PlayTest\Platform.UI.Runtime.Skia.PlayTest.csproj" />
		<!-- PlayTest references the WinRT surface privately (PrivateAssets="all", as every head does), so the
		     Microsoft.UI.Xaml types its gate factory names do not flow to this project. Reference the same
		     flavour PlayTest compiles against (the PlayTest suite does the same). -->
		<ProjectReference Include="..\Platform.UWP\Platform.Skia.csproj" />
	</ItemGroup>

</Project>
