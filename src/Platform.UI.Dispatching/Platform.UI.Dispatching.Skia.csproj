<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.Dispatching: since the Core/Skia split, the native pump only (DispatcherPumpSkiaPlatform, the
	*.skia.cs files). DispatcherQueue and the queue machinery are in CodeBrix.Platform.UI.Dispatching.Core
	(Platform.UI.Dispatching.Core.csproj).
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../targetframework-override.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.Dispatching</AssemblyName>
		<DefineConstants>$(DefineConstants);IS_CODEBRIX_UI_DISPATCHING_PROJECT</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<RootNamespace>CodeBrix.Platform.UI.Dispatching</RootNamespace>
		<DefineConstants>$(DefineConstants);XAMARIN;IS_CODEBRIX</DefineConstants>

		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Only the Skia files: the shared tree belongs to Platform.UI.Dispatching.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
		<CommonOverridePackageId>codebrix.platform.winrt</CommonOverridePackageId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI.Dispatching\Platform.UI.Dispatching.Core.csproj" />
	</ItemGroup>

</Project>
