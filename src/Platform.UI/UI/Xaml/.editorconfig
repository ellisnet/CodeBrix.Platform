# Folder-local settings, matching https://github.com/microsoft/microsoft-ui-xaml/blob/438e5ebd870f8e090b35140c456ea03f570da42c/.editorconfig
# (This repo has no root .editorconfig, so nothing is being overridden - these stand on their own.)

[**.{xaml,xml}]
indent_style = space
indent_size = 4
charset = utf-8-bom
insert_final_newline = true
trim_trailing_whitespace = true
[*.cs]
dotnet_diagnostic.CA1805.severity = none 
