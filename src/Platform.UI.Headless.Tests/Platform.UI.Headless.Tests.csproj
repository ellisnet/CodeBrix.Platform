<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>

		<!-- xUnit.net v3 test projects are self-executing binaries and must build as Exe;
		     run via Microsoft.Testing.Platform, matching the CodeBrix family test convention. -->
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

		<!-- The tests exercise the framework flavour that actually ships, not the .Reference API
		     shells (whose bodies throw). Same choice the add-in suites make. -->
		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>

		<AssemblyName>CodeBrix.Platform.UI.Headless.Tests</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.Headless.Tests</RootNamespace>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
	</ItemGroup>

	<!-- Skia's and HarfBuzz's native binaries have to be named per-OS: an application gets them
	     from its head package, and there is no head in a test run. Constructing a XAML element
	     pulls the framework's Skia flavour in, so they must be present on every OS this suite is
	     expected to pass on - Linux, Windows and macOS. -->
	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !$([MSBuild]::IsOSPlatform('OSX'))">
		<!-- ICU comes from the system dynamic linker search path on Linux, so it needs no package. -->
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<!-- Unlike Linux, Windows has no system ICU for the text engine to load, so it comes from
		     the Unicode package: icuuc77.dll as a runtime asset and icudt.dat beside this
		     (non-head) test Exe. See the note in Platform.UI.TextLayout.Tests for why no
		     $(IsCodeBrixHead) bootstrap is needed for that. -->
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="$(SkiaSharpVersion)" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="$(HarfBuzzSharpVersion)" />
		<PackageReference Include="CodeBrix.Platform.Unicode.ApacheLicenseForever" Version="1.0.249.1295" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<!-- macOS is in the same position as Windows: no system ICU to find. The sibling
		     UnicodeMacOs package supplies both libicuuc and libicudata, because macOS does not
		     pull the data library in through icuuc's load commands. -->
		<PackageReference Include="SkiaSharp.NativeAssets.macos" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
		<PackageReference Include="CodeBrix.Platform.UnicodeMacOs.ApacheLicenseForever" Version="1.0.249.1295" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI\Platform.UI.Skia.csproj" />
	</ItemGroup>

</Project>
