<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform: since the Core/Skia split, the Skia half of the WinRT API surface. It compiles ONLY the *.skia.cs
	files (the Skia implementations of the WinRT platform contracts, the OS launcher extensions) and references
	CodeBrix.Platform.Core (Platform.Core.csproj), which holds the API surface.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../targetframework-override.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform</AssemblyName>
		<RootNamespace>Windows</RootNamespace>
		<DefineConstants>$(DefineConstants);XAMARIN;IS_CODEBRIX;HAS_UMBRELLA_UI;HAS_UMBRELLA_BINDING;HAS_CRIPPLEDREFLECTION</DefineConstants>
		<CodeBrixDisableAnalyzersForSamples>true</CodeBrixDisableAnalyzersForSamples>


		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Only the Skia files: the shared tree belongs to Platform.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
		<CommonOverridePackageId>codebrix.platform.winrt</CommonOverridePackageId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UWP\Platform.Core.csproj" />
	</ItemGroup>

</Project>
