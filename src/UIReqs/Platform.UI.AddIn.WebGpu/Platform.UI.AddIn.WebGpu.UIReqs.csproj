<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.AddIn.WebGpu.UIReqs</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.AddIn.WebGpu.UIReqs</RootNamespace>

		<!-- The scenarios' renderer records real WebGPU commands (pointers to descriptor structs). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- The runner, the framework flavour, the packages, the fonts, the feature root and the
	     Skia-assembly swap. This is the Landscape project of the pair, so it sets no
	     $(UIReqsLandscapeProjectDir) - it IS one. -->
	<Import Project="..\UIReqs.Common.targets" />

	<ItemGroup>
		<!-- The core harness, referenced rather than duplicated: hosting, the canvas vocabulary,
		     the shared steps, the hooks and the argument transformations all come from here. This
		     project's reqnroll.json names that assembly as a binding assembly, which is what makes
		     its steps and hooks run for THESE scenarios. -->
		<ProjectReference Include="..\Platform.UI.Core\Platform.UI.Core.UIReqs.csproj" />

		<!-- The add-in whose requirements these are, in its .Skia flavour. CodeBrix.WebGpu.Skia (and through it
		     CodeBrix.WebGpu.Native with the engine's natives) flows in through it. -->
		<ProjectReference Include="..\..\AddIns\Platform.UI.WebGpu\Platform.UI.WebGpu.Skia.csproj" />

		<!-- The add-in references this with PrivateAssets="all" - the assembly has no nuget of its
		     own and ships inside the main framework package - so it does NOT flow across the
		     project reference into a test run, and the view logs through it (device ready, device
		     lost). The add-in's own .Tests csproj names it for exactly this reason. -->
		<ProjectReference Include="..\..\CodeBrix.Platform.Extensions.Logging\CodeBrix.Platform.Extensions.Logging.Core.csproj" />
	</ItemGroup>

</Project>
