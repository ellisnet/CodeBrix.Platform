<Project>
  <PropertyGroup>
    <IsCodeBrixHead Condition="'$(OutputType)'=='Exe'">true</IsCodeBrixHead>
  </PropertyGroup>
  <ItemGroup Condition="'$(CodeBrixPlayTestPreferredOrientation)' != ''">
    <AssemblyMetadata Include="CodeBrixPlayTestPreferredOrientation" Value="$(CodeBrixPlayTestPreferredOrientation)" />
  </ItemGroup>
  <ItemGroup Condition="'$(CodeBrixPlayTestPreferredTheme)' != ''">
    <AssemblyMetadata Include="CodeBrixPlayTestPreferredTheme" Value="$(CodeBrixPlayTestPreferredTheme)" />
  </ItemGroup>
  <Target Name="_CodeBrixPlayTestValidateTheme" BeforeTargets="GenerateAssemblyInfo"
          Condition="'$(CodeBrixPlayTestPreferredTheme)' != ''">
    <Error Condition="'$(CodeBrixPlayTestPreferredTheme)' != 'Light' and '$(CodeBrixPlayTestPreferredTheme)' != 'Dark'"
           Text="CodeBrixPlayTestPreferredTheme must be Light or Dark." />
    <Error Condition="'$(GenerateAssemblyInfo)' == 'false'"
           Text="CodeBrixPlayTestPreferredTheme requires GenerateAssemblyInfo, or an explicit AssemblyMetadata attribute instead of the MSBuild property." />
  </Target>
  <Target Name="_CodeBrixPlayTestValidateOrientation" BeforeTargets="GenerateAssemblyInfo"
          Condition="'$(CodeBrixPlayTestPreferredOrientation)' != ''">
    <Error Condition="'$(CodeBrixPlayTestPreferredOrientation)' != 'Landscape' and '$(CodeBrixPlayTestPreferredOrientation)' != 'Portrait'"
           Text="CodeBrixPlayTestPreferredOrientation must be Landscape or Portrait." />
    <Error Condition="'$(GenerateAssemblyInfo)' == 'false'"
           Text="CodeBrixPlayTestPreferredOrientation requires GenerateAssemblyInfo, or an explicit AssemblyMetadata attribute instead of the MSBuild property." />
  </Target>
  <Target Name="_CodeBrixPlayTestDefines" AfterTargets="PrepareForBuild">
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);CODEBRIX_REFERENCE_API;HAS_CODEBRIX;HAS_CODEBRIX_WINUI;HAS_CODEBRIX_SKIA;HAS_CODEBRIX_PLAYTEST;__DESKTOP__;__CODEBRIX_SKIA__</DefineConstants>
    </PropertyGroup>
  </Target>
  <Target Name="_CodeBrixPlayTestContent" BeforeTargets="CopyFilesToOutputDirectory;_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ContentWithTargetPath Update="@(ContentWithTargetPath)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
