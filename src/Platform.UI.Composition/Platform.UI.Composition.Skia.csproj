<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.Composition: since the Core/Skia split, the Skia half of the composition assembly. It compiles
	ONLY the *.skia.cs files (the Skia painting of the Visual tree, brushes, clips and surfaces) and references
	CodeBrix.Platform.UI.Composition.Core (Platform.UI.Composition.Core.csproj), which holds the composition API.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../targetframework-override.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.Composition</AssemblyName>
		<DefineConstants>$(DefineConstants);IS_CODEBRIX_COMPOSITION</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<RootNamespace>CodeBrix.Platform.UI.Composition</RootNamespace>
		<DefineConstants>$(DefineConstants);XAMARIN;IS_CODEBRIX</DefineConstants>

		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Only the Skia files: the shared tree belongs to Platform.UI.Composition.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
		<CommonOverridePackageId>CodeBrix.Platform.UI</CommonOverridePackageId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<Compile Include="..\Platform.UI\UI\Xaml\NonUniformCornerRadius.skia.cs" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI.Composition\Platform.UI.Composition.Core.csproj" />
	</ItemGroup>

</Project>
