<Project Sdk="Microsoft.NET.Sdk">
	<!-- Identity pinned to legacy names; rename step changed only the .csproj filename. -->
	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.Runtime.Skia.MacOS</AssemblyName>
	</PropertyGroup>


	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DefineConstants>CODEBRIX_REFERENCE_API;HAS_CODEBRIX_SKIA</DefineConstants>
	</PropertyGroup>

	<Import Project="../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<!-- Packed by build/CodeBrix.Platform.Build.csproj with the shared date-stamped version. -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<Title>CodeBrix.Platform.Runtime.Skia.MacOS</Title>
		<Description>macOS Skia runtime host for CodeBrix.Platform applications.</Description>

		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'!='true'">CodeBrix.Platform.Runtime.Skia.MacOS.ApacheLicenseForever</PackageId>

		<RootNamespace>CodeBrix.Platform.UI.Runtime.Skia.MacOS</RootNamespace>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp.NativeAssets.macos" GeneratePathProperty="true" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
		<PackageReference Include="HarfBuzzSharp" />
		<PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="CodeBrix.Platform.UnicodeMacOs.ApacheLicenseForever" Version="1.0.249.1295" />
	</ItemGroup>

	<PropertyGroup>
		<_XcodeBuildArgs Condition="'$(Configuration)'=='Debug'">build-for-testing -scheme CodeBrixNativeMac</_XcodeBuildArgs>

		<!-- Preserve the regular Apple Silicon/Xcode packaging workflow. Apple's
		     Command Line Tools also build a universal dylib on either CPU. -->
		<NativeMacBuildTool Condition="'$(NativeMacBuildTool)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">Xcode</NativeMacBuildTool>
		<NativeMacBuildTool Condition="'$(NativeMacBuildTool)' == ''">Clang</NativeMacBuildTool>
		<BuildNativeMac Condition="'$(BuildNativeMac)' == '' and $([MSBuild]::IsOsPlatform('OSX'))">true</BuildNativeMac>
		<BuildNativeMac Condition="'$(BuildNativeMac)' == ''">false</BuildNativeMac>

		<!-- Contribute the freshly-built native dylib to the package at pack time.
		     A static globbed <None Pack="true"> would be evaluated BEFORE the native
		     build runs (and build.sh wipes build/ first), so it would capture nothing
		     on a clean pack. A target-time item list reliably picks up the dylib. -->
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddNativeMacToPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<_NativeMacSource Include="$(MSBuildThisFileDirectory)PlatformNativeMac/PlatformNativeMac/*.m;$(MSBuildThisFileDirectory)PlatformNativeMac/PlatformNativeMac/*.h;$(MSBuildThisFileDirectory)PlatformNativeMac/PlatformNativeMac/*.sh;$(MSBuildThisFileDirectory)PlatformNativeMac/*.sh;$(MSBuildThisFileDirectory)PlatformNativeMac/PlatformNativeMac.xcodeproj/project.pbxproj;$(MSBuildProjectFullPath)" />
	</ItemGroup>
	<Target Name="BuildCodeBrixNativeMac" BeforeTargets="CoreCompile" Condition="'$(BuildNativeMac)' == 'true'"
			Inputs="@(_NativeMacSource);$(PkgSkiaSharp_NativeAssets_macos)/runtimes/osx/native/libSkiaSharp.dylib"
			Outputs="$(MSBuildThisFileDirectory)PlatformNativeMac/build/$(Configuration)/libCodeBrixNativeMac.dylib">
		<Exec Condition="'$(NativeMacBuildTool)' == 'Clang'" Command="bash &quot;$(MSBuildThisFileDirectory)PlatformNativeMac/build-clang.sh&quot; &quot;$(Configuration)&quot; &quot;$(PkgSkiaSharp_NativeAssets_macos)/runtimes/osx/native/libSkiaSharp.dylib&quot;" />
		<Exec Condition="'$(NativeMacBuildTool)' == 'Xcode'" Command="bash &quot;$(MSBuildThisFileDirectory)PlatformNativeMac/build.sh&quot; $(_XcodeBuildArgs)" WorkingDirectory="$(MSBuildThisFileDirectory)PlatformNativeMac/" />
		<Error Condition="'$(NativeMacBuildTool)' != 'Clang' and '$(NativeMacBuildTool)' != 'Xcode'" Text="NativeMacBuildTool must be Clang or Xcode." />
	</Target>

	<Target Name="_ReportSkippedNativeMac" BeforeTargets="CoreCompile" Condition="'$(BuildNativeMac)' != 'true' and $([MSBuild]::IsOsPlatform('OSX'))">
		<Message Importance="high" Text="Skipping native macOS build (BuildNativeMac=false). Managed build only." />
	</Target>

	<Target Name="_AddNativeMacToPackage" DependsOnTargets="BuildCodeBrixNativeMac" Condition="'$(BuildNativeMac)' == 'true'">
		<Error Condition="!Exists('$(MSBuildThisFileDirectory)PlatformNativeMac/build/$(Configuration)/libCodeBrixNativeMac.dylib')"
			   Text="Native macOS dylib not found at PlatformNativeMac/build/$(Configuration)/libCodeBrixNativeMac.dylib — the native build did not produce it, so the package would be managed-only." />
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)PlatformNativeMac/build/$(Configuration)/libCodeBrixNativeMac.dylib">
				<PackagePath>runtimes/osx/native</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\Platform.Foundation\Platform.Foundation.Core.csproj" TreatAsPackageReference="false" PrivateAssets="all" />
		<ProjectReference Include="..\Platform.UI.Runtime.Skia.Linux.FrameBuffer\Platform.UI.Runtime.Skia.Linux.FrameBuffer.csproj" />
		<ProjectReference Include="..\Platform.UI\Platform.UI.Skia.csproj" />
		<ProjectReference Include="..\Platform.UWP\Platform.Skia.csproj" TreatAsPackageReference="false" PrivateAssets="all" />
		<ProjectReference Include="..\Platform.UI.Runtime.Skia\Platform.UI.Runtime.Skia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Pack the buildTransitive props/targets renamed to <PackageId>.props/.targets so
		     NuGet auto-imports them for consumers (and to satisfy NU5129). -->
		<Content Include="buildTransitive\Platform.WinUI.Runtime.Skia.MacOS.props">
			<Pack>true</Pack>
			<PackagePath>buildTransitive\CodeBrix.Platform.Runtime.Skia.MacOS.ApacheLicenseForever.props</PackagePath>
		</Content>
		<Content Include="buildTransitive\Platform.WinUI.Runtime.Skia.MacOS.targets">
			<Pack>true</Pack>
			<PackagePath>buildTransitive\CodeBrix.Platform.Runtime.Skia.MacOS.ApacheLicenseForever.targets</PackagePath>
		</Content>
	</ItemGroup>

</Project>
