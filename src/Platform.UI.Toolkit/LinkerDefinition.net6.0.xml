<linker>
  <!--
  Roots the Toolkit's XAML-facing types (the attached-property extension classes, the FromJson markup extension, the
  TriPaneView control) for the XAML heads: the Skia heads and CodeBrix.Android keep them by default. A consumer that
  uses no XAML from this assembly (a CodeBrix.Mobile app that uses only engine types) turns the rooting off with
      <RuntimeHostConfigurationOption Include="CodeBrix.Platform.UI.Toolkit.RootXamlControls" Value="false" Trim="true" />
  (the same feature-switch mechanism the framework's own trimming options use; WPE1 C2, MAINTAINER-README "TRIMMING").
  -->
  <assembly fullname="CodeBrix.Platform.UI.Toolkit.Core">
	<type fullname="CodeBrix.Platform.UI.Toolkit.CommandBarExtensions" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
	<type fullname="CodeBrix.Platform.UI.Toolkit.MenuFlyoutItemExtensions" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
	<type fullname="CodeBrix.Platform.UI.Toolkit.UIElementExtensions" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
	<type fullname="CodeBrix.Platform.UI.Toolkit.MenuFlyoutExtensions" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
	<type fullname="CodeBrix.Platform.UI.Toolkit.SplitViewExtensions" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
	<type fullname="CodeBrix.Platform.UI.Markup.FromJsonExtension" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
	<type fullname="CodeBrix.Platform.UI.Toolkit.TriPaneView" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
	<type fullname="CodeBrix.Platform.UI.Toolkit.TriPaneViewDivider" feature="CodeBrix.Platform.UI.Toolkit.RootXamlControls" featurevalue="true" featuredefault="true"/>
  </assembly>
</linker>
