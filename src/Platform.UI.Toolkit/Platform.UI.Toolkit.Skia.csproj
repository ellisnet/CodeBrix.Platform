<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.Toolkit: since the Core/Skia split, only the Skia implementation of IElevationPlatform (the
	*.skia.cs files). The toolkit's controls, helpers and XAML are in CodeBrix.Platform.UI.Toolkit.Core
	(Platform.UI.Toolkit.Core.csproj).
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../targetframework-override.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.Toolkit</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.Toolkit</RootNamespace>
		<DefaultLanguage>en-US</DefaultLanguage>

		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Only the Skia files: the shared tree belongs to Platform.UI.Toolkit.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableAutomaticXamlPageInclusion>false</EnableAutomaticXamlPageInclusion>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
		<CommonOverridePackageId>CodeBrix.Platform.UI</CommonOverridePackageId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI.Toolkit\Platform.UI.Toolkit.Core.csproj" />
	</ItemGroup>

	<!-- Override existing target, this project cannot be published -->
	<Target Name="Publish" />

</Project>
