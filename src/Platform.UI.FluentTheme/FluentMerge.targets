<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <PropertyGroup>
	<PageExclusions>$(MSBuildThisFileDirectory)Resources\**\*.xaml</PageExclusions>
  </PropertyGroup>

  <!--
  Naming the task host architecture works around an MSBuild ARM64 handshake bug under Visual
  Studio; see src/SourceGenerators/Platform.UI.Tasks/Content/Platform.UI.Tasks.targets for the
  full explanation. Defined inline rather than in a Directory.Build.* file because several
  subtrees under src/ carry their own Directory.Build.targets, which shadow the repo root.
  Remove once MSBuild is fixed.
  -->
  <PropertyGroup>
	<CodeBrixNetTaskHostArchitecture Condition="'$(CodeBrixNetTaskHostArchitecture)'=='' AND '$(NETCoreSdkRuntimeIdentifier)'!='' AND $(NETCoreSdkRuntimeIdentifier.EndsWith('-arm64'))">arm64</CodeBrixNetTaskHostArchitecture>
	<CodeBrixNetTaskHostArchitecture Condition="'$(CodeBrixNetTaskHostArchitecture)'==''">*</CodeBrixNetTaskHostArchitecture>
  </PropertyGroup>

  <UsingTask TaskName="BatchMergeXaml" AssemblyFile="$(CodeBrixUIMSBuildTasksPath)\CodeBrix.Platform.UI.Tasks.v0.dll" Runtime="NET" Architecture="$(CodeBrixNetTaskHostArchitecture)" TaskFactory="TaskHostFactory" />


  <PropertyGroup Condition="'$(CodeBrixRuntimeIdentifier)'=='Reference'">
	<EnableAutomaticXamlPageInclusion>false</EnableAutomaticXamlPageInclusion>
  </PropertyGroup>

  <PropertyGroup>
	<CodeBrixUIMSBuildTasksPath>$(MSBuildThisFileDirectory)..\SourceGenerators\Platform.UI.Tasks\bin\$(Configuration)_Shadow</CodeBrixUIMSBuildTasksPath>
  </PropertyGroup>

  <Import Project="..\SourceGenerators\Platform.UI.SourceGenerators\Content\Platform.UI.SourceGenerators.props" />

</Project>
