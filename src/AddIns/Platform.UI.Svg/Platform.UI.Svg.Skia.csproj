<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.Svg: since the Core/Skia split, only the composition hookup (the *.skia.cs files: the
	[assembly: ApiExtension] that registers SvgProvider as the framework's ISvgProvider - the XAML source generator of
	an application finds it in this referenced assembly and emits the registration) and the package id. SvgProvider and
	the drawing are in CodeBrix.Platform.UI.Svg.Core (Platform.UI.Svg.Core.csproj), which the package carries beside
	this assembly (build/nuget/Platform.WinUI.Svg.nuspec).
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override.props" />

	<PropertyGroup>
		<Deterministic>true</Deterministic>

		<AssemblyName>CodeBrix.Platform.UI.Svg</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.Svg</RootNamespace>

		<!-- PackageId is NOT the assembly name: this project never packs itself (its package is
		     built from build/nuget/Platform.WinUI.Svg.nuspec by build/CodeBrix.Platform.Build.csproj),
		     so the only thing PackageId governs is how another project in this repository that takes
		     a ProjectReference to it resolves its package dependency. That has to be the PUBLISHED
		     id, the one the nuspec and build/nuget/package-dependency-map.json both name - otherwise
		     a referencing package (the CommandBar add-in, whose SVG icons make the Svg add-in a hard
		     dependency) would ship a dependency on an id that has never been published. Same
		     arrangement as Platform.WinUI.Graphics3DGL.csproj, for the VideoPlayer add-in. -->
		<PackageId>CodeBrix.Platform.Svg.ApacheLicenseForever</PackageId>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>
		<Nullable>enable</Nullable>

		<!-- Only the Skia files: the shared tree belongs to Platform.UI.Svg.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CodeBrix.SkiaSvg.MitLicenseForever" Version="1.0.278.1152" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Platform.UI.Svg.Core.csproj" />
		<ProjectReference Include="..\..\Platform.Foundation\Platform.Foundation.Core.csproj" />
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
		<ProjectReference Include="..\CodeBrix.Platform.SkiaSharp.Views\CodeBrix.Platform.SkiaSharp.Views.Skia.csproj" />
		<ProjectReference Include="..\Platform.WinUI.Graphics2DSK\Platform.WinUI.Graphics2DSK.Core.csproj" />
	</ItemGroup>

	<Target Name="_CodeBrixUISvgOverrideNuget" AfterTargets="AfterBuild" DependsOnTargets="BuiltProjectOutputGroup" Condition="'$(CodeBrixNugetOverrideVersion)'!=''">

		<PropertyGroup>
			<_OverrideTargetFramework>$(TargetFramework)</_OverrideTargetFramework>
			<_TargetNugetFolder>$(NuGetPackageRoot)\codebrix.platform.ui.svg\$(CodeBrixNugetOverrideVersion)\codebrix-platform-runtime\$(CodeBrixRuntimeIdentifier.ToLowerInvariant())</_TargetNugetFolder>
		</PropertyGroup>
		<ItemGroup>
			<_OutputFiles Include="$(TargetDir)**" />
		</ItemGroup>
		<MakeDir Directories="$(_TargetNugetFolder)" />

		<Message Importance="high" Text="OVERRIDING NUGET PACKAGE CACHE: $(_TargetNugetFolder)" />

		<Copy SourceFiles="@(_OutputFiles)" DestinationFiles="@(_OutputFiles->'$(_TargetNugetFolder)\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Copy SourceFiles="@(_OutputFilesPDB)" DestinationFiles="@(_OutputFilesPDB->'$(_TargetNugetFolder)\%(RecursiveDir)%(Filename).pdb')" />
	</Target>

</Project>
