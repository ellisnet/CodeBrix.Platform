<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.AppSettings</AssemblyName>
		<RootNamespace>CodeBrix.Platform.AppSettings</RootNamespace>

		<!-- This AddIn is packed by the central driver (build/CodeBrix.Platform.Build.csproj, the
		     _CsprojPackage list), which date-stamps it and drops it in {repo}/nugets/Release with
		     the rest of the family - so no GeneratePackageOnBuild here. -->
		<!-- Ships the standard CodeBrix doc set (icon, README, AGENT-README, THIRD-PARTY-NOTICES) as
		     package content via the ItemGroup below, matching the AudioPlayer add-in's configuration. -->
		<PackageIcon>icon-codebrix-128.png</PackageIcon>
		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'=='false'">CodeBrix.Platform.AppSettings.ApacheLicenseForever</PackageId>
		<Description>A simple way to store and retrieve your application's settings, with no user interface of its own. It handles backups and recovery automatically, so a corrupted settings file never loses your users' preferences. Settings are stored in a single SQLite database file, making them easy to inspect, back up, or move between machines.</Description>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<!-- The SQLite engine behind settings.sqlite. External to the CodeBrix.Platform family, so
		     this reference is versioned here (not family-locked); bump deliberately. -->
		<PackageReference Include="CodeBrix.Sqlite.ApacheLicenseForever" Version="1.0.238.153" />

		<!-- ILogger/ILoggerFactory, which AppSettingLoggingService forwards through. Referenced
		     PUBLICLY on purpose: the Extensions.Logging project reference below is PrivateAssets="all"
		     (its assembly ships inside the main framework package), so nothing would carry
		     Microsoft.Extensions.Logging.Abstractions to a consumer otherwise - and the very first
		     line this add-in logs would fail to JIT with a FileNotFoundException. Version matches the
		     10.0.11 the family pins for the other Microsoft.Extensions.Logging.* packages. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<!-- Platform.UI.Skia packs as the CodeBrix.Platform.ApacheLicenseForever dependency, at the
		     same family version as this build (the whole family ships together). This add-in draws
		     nothing and references no XAML type - the dependency exists so the consumer has the
		     assembly that carries LogExtensionPoint, which AppSettingLoggingService forwards to.
		     Every consumer is a CodeBrix.Platform application and already has that package.
		     Extensions.Logging is PrivateAssets="all" because it has no standalone nuget - its
		     assembly ships inside the main framework package. -->
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
		<ProjectReference Include="..\..\CodeBrix.Platform.Extensions.Logging\CodeBrix.Platform.Extensions.Logging.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
