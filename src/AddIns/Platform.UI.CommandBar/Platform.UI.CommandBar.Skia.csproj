<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.CommandBar: since the Core/Skia split, only the Skia implementation of the add-in's platform
	contract (the *.skia.cs files: SVG icon rasterisation through the Svg add-in) and the package. The controls, the
	icon model and the default styles are in CodeBrix.Platform.UI.CommandBar.Core (Platform.UI.CommandBar.Core.csproj),
	which this package carries beside this assembly.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.CommandBar</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.CommandBar</RootNamespace>

		<!-- This AddIn is packed by the central driver (build/CodeBrix.Platform.Build.csproj, the
		     _CsprojPackage list), which date-stamps it and drops it in {repo}/nugets/Release with
		     the rest of the family - so no GeneratePackageOnBuild here. -->
		<!-- Ships the standard CodeBrix doc set (icon, README, AGENT-README, THIRD-PARTY-NOTICES) as
		     package content via the ItemGroup below, matching the FlexPanel add-in's configuration. -->
		<PackageIcon>icon-codebrix-128.png</PackageIcon>
		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'=='false'">CodeBrix.Platform.CommandBar.ApacheLicenseForever</PackageId>
		<Description>A family of tool bar and command bar controls - buttons, toggle buttons, drop-down buttons, and separators - that bind to your view-model's commands. Handles layout, grouping, and overflow into a menu automatically when there isn't enough room. Icons can be SVG (tinted and sharp at any screen size) or ordinary image files, and buttons can show an icon, text, or both.</Description>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Only the Skia files: the shared tree (and Themes/Generic.xaml) belongs to Platform.UI.CommandBar.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableAutomaticXamlPageInclusion>false</EnableAutomaticXamlPageInclusion>

		<!-- The add-in ships its IntelliSense text: the .xml lands beside the dll in the build
		     output and the pack driver takes the whole output folder, so nothing in the packaging
		     recipe needs to know about it. CS1591 (a public member with no XML comment) is fixed at
		     source rather than suppressed - the comment IS the deliverable here. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<ItemGroup>
		<!-- The add-in's Core assembly ships INSIDE this package (CodeBrixBundleInPackage, see
		     ../AddIn.CorePackaging.targets): not a package dependency, the same nupkg. -->
		<ProjectReference Include="Platform.UI.CommandBar.Core.csproj" CodeBrixBundleInPackage="true" />

		<!-- Platform.UI.Skia packs as the CodeBrix.Platform.ApacheLicenseForever dependency, at the
		     same family version as this build (the whole family ships together). -->
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />

		<!-- The Svg add-in is a HARD dependency: there is no version of this add-in without SVG
		     icons. It is nuspec-driven, so its csproj carries its PUBLISHED PackageId
		     (CodeBrix.Platform.Svg.ApacheLicenseForever) for the SDK packer to read here - the same
		     arrangement Platform.WinUI.Graphics3DGL.csproj carries for the VideoPlayer add-in.
		     It brings CodeBrix.SkiaSvg (MIT) and the SkiaSharp.Views add-in transitively. -->
		<ProjectReference Include="..\Platform.UI.Svg\Platform.UI.Svg.Skia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<Import Project="..\AddIn.CorePackaging.targets" />
</Project>
