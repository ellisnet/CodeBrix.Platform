<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:cb="using:CodeBrix.Platform.UI.CommandBar">

	<!--
	================================================================================
	The CommandBar add-in's default styles and theme resources.

	HOW THIS FILE IS DIVIDED. Three streams extend this file in parallel, so every
	region below is owned by exactly one of them and nobody edits another's region:

	    SHARED   the theme dictionaries and the size/metric resources under them.
	             Written once, in the scaffold; treat the KEYS as frozen. A stream
	             that needs a NEW key adds it inside its own sub-region marker in
	             each of the three theme dictionaries (LAYOUT / BUTTONS / ICONS),
	             never by editing a key it does not own.
	    LAYOUT   the ToolBarTray / ToolBar / ToolBarGroup / ToolBarSeparator /
	             ToolBarSpacer styles.
	    BUTTONS  the ToolButton / ToolToggleButton / ToolDropDownButton styles.
	    ICONS    anything the icon types need in the visual tree.

	Each region is delimited by a BEGIN and an END comment carrying the stream name.
	Add inside your own region and the three patches merge without a conflict.
	================================================================================
	-->

	<ResourceDictionary.ThemeDictionaries>

		<!-- "Default" is the DARK dictionary; that is the framework's convention, not a typo. -->
		<ResourceDictionary x:Key="Default">
			<!-- ===== BEGIN SHARED brushes (dark) ===== -->
			<SolidColorBrush x:Key="ToolBarBackground" Color="#1F1F1F" />
			<SolidColorBrush x:Key="ToolBarBorderBrush" Color="#2D2D2D" />
			<SolidColorBrush x:Key="ToolBarForeground" Color="#FFFFFF" />
			<SolidColorBrush x:Key="ToolBarSeparatorBrush" Color="#3D3D3D" />
			<SolidColorBrush x:Key="ToolButtonBackground" Color="Transparent" />
			<SolidColorBrush x:Key="ToolButtonForeground" Color="#FFFFFF" />
			<SolidColorBrush x:Key="ToolButtonBorderBrush" Color="Transparent" />
			<SolidColorBrush x:Key="ToolButtonHoverBackground" Color="#2F2F2F" />
			<SolidColorBrush x:Key="ToolButtonHoverForeground" Color="#FFFFFF" />
			<SolidColorBrush x:Key="ToolButtonPressedBackground" Color="#3A3A3A" />
			<SolidColorBrush x:Key="ToolButtonPressedForeground" Color="#E0E0E0" />
			<SolidColorBrush x:Key="ToolButtonCheckedBackground" Color="#3D5A80" />
			<SolidColorBrush x:Key="ToolButtonCheckedForeground" Color="#FFFFFF" />
			<SolidColorBrush x:Key="ToolButtonCheckedHoverBackground" Color="#48699A" />
			<SolidColorBrush x:Key="ToolButtonDisabledForeground" Color="#6E6E6E" />
			<SolidColorBrush x:Key="ToolButtonFocusVisualPrimaryBrush" Color="#FFFFFF" />
			<SolidColorBrush x:Key="ToolButtonFocusVisualSecondaryBrush" Color="#000000" />
			<!-- ===== END SHARED brushes (dark) ===== -->

			<!-- ===== BEGIN LAYOUT brushes (dark) ===== -->
			<!-- ===== END LAYOUT brushes (dark) ===== -->

			<!-- ===== BEGIN BUTTONS brushes (dark) ===== -->
			<SolidColorBrush x:Key="ToolDropDownArrowBrush" Color="#E0E0E0" />
			<SolidColorBrush x:Key="ToolDropDownPartSeparatorBrush" Color="#4A4A4A" />
			<!-- ===== END BUTTONS brushes (dark) ===== -->

			<!-- ===== BEGIN ICONS brushes (dark) ===== -->
			<!-- ===== END ICONS brushes (dark) ===== -->
		</ResourceDictionary>

		<ResourceDictionary x:Key="Light">
			<!-- ===== BEGIN SHARED brushes (light) ===== -->
			<SolidColorBrush x:Key="ToolBarBackground" Color="#F3F3F3" />
			<SolidColorBrush x:Key="ToolBarBorderBrush" Color="#E5E5E5" />
			<SolidColorBrush x:Key="ToolBarForeground" Color="#1B1B1B" />
			<SolidColorBrush x:Key="ToolBarSeparatorBrush" Color="#D0D0D0" />
			<SolidColorBrush x:Key="ToolButtonBackground" Color="Transparent" />
			<SolidColorBrush x:Key="ToolButtonForeground" Color="#1B1B1B" />
			<SolidColorBrush x:Key="ToolButtonBorderBrush" Color="Transparent" />
			<SolidColorBrush x:Key="ToolButtonHoverBackground" Color="#E4E4E4" />
			<SolidColorBrush x:Key="ToolButtonHoverForeground" Color="#1B1B1B" />
			<SolidColorBrush x:Key="ToolButtonPressedBackground" Color="#D6D6D6" />
			<SolidColorBrush x:Key="ToolButtonPressedForeground" Color="#3A3A3A" />
			<SolidColorBrush x:Key="ToolButtonCheckedBackground" Color="#CCE0F5" />
			<SolidColorBrush x:Key="ToolButtonCheckedForeground" Color="#1B1B1B" />
			<SolidColorBrush x:Key="ToolButtonCheckedHoverBackground" Color="#BBD5EF" />
			<SolidColorBrush x:Key="ToolButtonDisabledForeground" Color="#9A9A9A" />
			<SolidColorBrush x:Key="ToolButtonFocusVisualPrimaryBrush" Color="#000000" />
			<SolidColorBrush x:Key="ToolButtonFocusVisualSecondaryBrush" Color="#FFFFFF" />
			<!-- ===== END SHARED brushes (light) ===== -->

			<!-- ===== BEGIN LAYOUT brushes (light) ===== -->
			<!-- ===== END LAYOUT brushes (light) ===== -->

			<!-- ===== BEGIN BUTTONS brushes (light) ===== -->
			<SolidColorBrush x:Key="ToolDropDownArrowBrush" Color="#3A3A3A" />
			<SolidColorBrush x:Key="ToolDropDownPartSeparatorBrush" Color="#C4C4C4" />
			<!-- ===== END BUTTONS brushes (light) ===== -->

			<!-- ===== BEGIN ICONS brushes (light) ===== -->
			<!-- ===== END ICONS brushes (light) ===== -->
		</ResourceDictionary>

		<ResourceDictionary x:Key="HighContrast">
			<!-- ===== BEGIN SHARED brushes (high contrast) =====
			     Every value here is one of the framework's system-colour brushes
			     (Common_themeresources_any.xaml in the core), so the bar follows the
			     user's high-contrast scheme rather than inventing colours of its own. -->
			<StaticResource x:Key="ToolBarBackground" ResourceKey="SystemColorButtonFaceColorBrush" />
			<StaticResource x:Key="ToolBarBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="ToolBarForeground" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="ToolBarSeparatorBrush" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="ToolButtonBackground" ResourceKey="SystemColorButtonFaceColorBrush" />
			<StaticResource x:Key="ToolButtonForeground" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="ToolButtonBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="ToolButtonHoverBackground" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="ToolButtonHoverForeground" ResourceKey="SystemColorHighlightTextColorBrush" />
			<StaticResource x:Key="ToolButtonPressedBackground" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="ToolButtonPressedForeground" ResourceKey="SystemColorHighlightTextColorBrush" />
			<StaticResource x:Key="ToolButtonCheckedBackground" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="ToolButtonCheckedForeground" ResourceKey="SystemColorHighlightTextColorBrush" />
			<StaticResource x:Key="ToolButtonCheckedHoverBackground" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="ToolButtonDisabledForeground" ResourceKey="SystemColorGrayTextColorBrush" />
			<StaticResource x:Key="ToolButtonFocusVisualPrimaryBrush" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="ToolButtonFocusVisualSecondaryBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
			<!-- ===== END SHARED brushes (high contrast) ===== -->

			<!-- ===== BEGIN LAYOUT brushes (high contrast) ===== -->
			<!-- ===== END LAYOUT brushes (high contrast) ===== -->

			<!-- ===== BEGIN BUTTONS brushes (high contrast) ===== -->
			<StaticResource x:Key="ToolDropDownArrowBrush" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="ToolDropDownPartSeparatorBrush" ResourceKey="SystemColorButtonTextColorBrush" />
			<!-- ===== END BUTTONS brushes (high contrast) ===== -->

			<!-- ===== BEGIN ICONS brushes (high contrast) ===== -->
			<!-- ===== END ICONS brushes (high contrast) ===== -->
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

	<!-- ===== BEGIN SHARED metrics =====
	     Sizes are theme-independent, so they live outside the theme dictionaries.
	     The defaults are the desktop tool bar convention: a 24 px icon in a 32 px
	     high button, 4 px between items, 8 px around a separator. -->
	<x:Double x:Key="ToolBarIconSize">24</x:Double>
	<x:Double x:Key="ToolBarItemSpacing">4</x:Double>
	<x:Double x:Key="ToolBarGroupSpacing">4</x:Double>
	<x:Double x:Key="ToolBarTraySpacing">8</x:Double>
	<x:Double x:Key="ToolBarMinButtonHeight">32</x:Double>
	<x:Double x:Key="ToolBarMinButtonWidth">32</x:Double>
	<x:Double x:Key="ToolBarCompactMinButtonHeight">26</x:Double>
	<x:Double x:Key="ToolBarChevronWidth">28</x:Double>
	<x:Double x:Key="ToolBarSeparatorThickness">1</x:Double>
	<x:Double x:Key="ToolBarLabelFontSize">12</x:Double>
	<x:Double x:Key="ToolBarLabelSpacing">6</x:Double>
	<Thickness x:Key="ToolBarPadding">4</Thickness>
	<Thickness x:Key="ToolBarBorderThickness">0,0,0,1</Thickness>
	<Thickness x:Key="ToolButtonPadding">6,4,6,4</Thickness>
	<Thickness x:Key="ToolBarSeparatorMargin">8,4,8,4</Thickness>
	<CornerRadius x:Key="ToolBarCornerRadius">0</CornerRadius>
	<CornerRadius x:Key="ToolButtonCornerRadius">4</CornerRadius>
	<!-- ===== END SHARED metrics ===== -->

	<!-- ===== BEGIN LAYOUT styles =====
	     Owned by the LAYOUT stream: ToolBarTray, ToolBar (and its items panel),
	     ToolBarGroup, ToolBarSeparator, ToolBarSpacer. -->

	<Style x:Key="DefaultToolBarSeparatorStyle" TargetType="cb:ToolBarSeparator">
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="IsHitTestVisible" Value="False" />
		<Setter Property="Foreground" Value="{ThemeResource ToolBarSeparatorBrush}" />
		<Setter Property="Margin" Value="{StaticResource ToolBarSeparatorMargin}" />
		<Setter Property="Thickness" Value="{StaticResource ToolBarSeparatorThickness}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="cb:ToolBarSeparator">
					<!-- No Width here on purpose: the separator's own content box is already exactly
					     Thickness DEVICE pixels wide (see ToolBarSeparator.LogicalThickness), so a
					     stretched rectangle fills it and lands on the pixel grid at any display
					     scale. A Width in logical pixels would be 1.25 device pixels at 125%, which
					     is what makes a hairline look like a smear. -->
					<Rectangle x:Name="PART_Line" Fill="{TemplateBinding Foreground}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="cb:ToolBarSeparator" BasedOn="{StaticResource DefaultToolBarSeparatorStyle}" />

	<Style x:Key="DefaultToolBarStyle" TargetType="cb:ToolBar">
		<Setter Property="IsTabStop" Value="False" />
		<!-- Once: Tab moves INTO the bar and lands on the first item, and the next Tab leaves
		     the bar entirely. Moving between the items is the arrow keys' job. -->
		<Setter Property="TabNavigation" Value="Once" />
		<Setter Property="Background" Value="{ThemeResource ToolBarBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource ToolBarForeground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ToolBarBorderBrush}" />
		<Setter Property="BorderThickness" Value="{StaticResource ToolBarBorderThickness}" />
		<Setter Property="Padding" Value="{StaticResource ToolBarPadding}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ToolButtonFocusVisualPrimaryBrush}" />
		<Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ToolButtonFocusVisualSecondaryBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="cb:ToolBar">
					<Border x:Name="PART_Root"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource ToolBarCornerRadius}"
							Padding="{TemplateBinding Padding}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="DensityStates">
								<VisualState x:Name="Comfortable" />
								<VisualState x:Name="Compact">
									<VisualState.Setters>
										<Setter Target="PART_Root.Padding" Value="2" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<!-- The bar hosts its items in its OWN panel rather than in an ItemsPresenter:
						     chevron overflow moves the same element instances between this panel and
						     the flyout's, which an items presenter's child management would undo. -->
						<cb:ToolBarPanel x:Name="PART_ItemsHost" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="cb:ToolBar" BasedOn="{StaticResource DefaultToolBarStyle}" />

	<Style x:Key="DefaultToolBarOverflowButtonStyle" TargetType="cb:ToolBarOverflowButton">
		<Setter Property="Background" Value="{ThemeResource ToolButtonBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource ToolButtonForeground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ToolButtonBorderBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="{StaticResource ToolBarChevronWidth}" />
		<Setter Property="MinHeight" Value="{StaticResource ToolBarMinButtonHeight}" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ToolButtonFocusVisualPrimaryBrush}" />
		<Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ToolButtonFocusVisualSecondaryBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="cb:ToolBarOverflowButton">
					<Border x:Name="PART_Root"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource ToolButtonCornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="PART_Root.Background" Value="{ThemeResource ToolButtonHoverBackground}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="PART_Root.Background" Value="{ThemeResource ToolButtonPressedBackground}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="PART_Chevron.Fill" Value="{ThemeResource ToolButtonDisabledForeground}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<!-- A drawn chevron, not a glyph: the bar must show its overflow affordance on a
						     head with no symbol font, and a path follows the theme through Foreground
						     like everything else in the bar. -->
						<Path x:Name="PART_Chevron"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Fill="{TemplateBinding Foreground}"
							  Data="M 0,0 L 4,4 L 0,8 L 1.6,8 L 5.6,4 L 1.6,0 Z M 4.4,0 L 8.4,4 L 4.4,8 L 6,8 L 10,4 L 6,0 Z" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="cb:ToolBarOverflowButton" BasedOn="{StaticResource DefaultToolBarOverflowButtonStyle}" />

	<!-- ===== END LAYOUT styles ===== -->

	<!-- ===== BEGIN BUTTONS styles =====
	     Owned by the BUTTONS stream: ToolButton, ToolToggleButton,
	     ToolDropDownButton, and the overflow chevron button. -->

	<!-- WinUI XAML has no {x:Type}: a style another style is BasedOn must carry an x:Key, and
	     the implicit style for the type is then a one-line style based on it. That is the shape
	     the framework's own themeresources use, and the reason for the keyed style below. -->
	<Style x:Key="DefaultToolButtonStyle" TargetType="cb:ToolButton">
		<Setter Property="Background" Value="{ThemeResource ToolButtonBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource ToolButtonForeground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ToolButtonBorderBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="{StaticResource ToolButtonPadding}" />
		<Setter Property="MinHeight" Value="{StaticResource ToolBarMinButtonHeight}" />
		<Setter Property="MinWidth" Value="{StaticResource ToolBarMinButtonWidth}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="cb:ToolButton">
					<Border x:Name="PART_Root"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource ToolButtonCornerRadius}"
							Padding="{TemplateBinding Padding}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Root" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonHoverBackground}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonHoverForeground}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Root" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonPressedBackground}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonPressedForeground}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonDisabledForeground}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Icon" Storyboard.TargetProperty="Opacity">
											<DiscreteDoubleKeyFrame KeyTime="0" Value="0.4" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<StackPanel x:Name="PART_Layout"
									Orientation="{TemplateBinding LabelOrientation}"
									Spacing="{StaticResource ToolBarLabelSpacing}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
							<ContentPresenter x:Name="PART_Icon"
											  Content="{TemplateBinding IconVisual}"
											  Visibility="{TemplateBinding IconVisibility}"
											  Width="{TemplateBinding EffectiveIconSize}"
											  Height="{TemplateBinding EffectiveIconSize}"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
							<TextBlock x:Name="PART_Text"
									   Text="{TemplateBinding ResolvedText}"
									   Visibility="{TemplateBinding TextVisibility}"
									   Foreground="{TemplateBinding Foreground}"
									   FontSize="{StaticResource ToolBarLabelFontSize}"
									   TextAlignment="Center"
									   VerticalAlignment="Center" />
						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="cb:ToolButton" BasedOn="{StaticResource DefaultToolButtonStyle}" />

	<!-- The toggle repeats the whole template rather than inheriting it, because a checked state
	     is a SECOND state group and a style cannot add one to a template it inherits. -->
	<Style x:Key="DefaultToolToggleButtonStyle" TargetType="cb:ToolToggleButton"
		   BasedOn="{StaticResource DefaultToolButtonStyle}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="cb:ToolToggleButton">
					<Border x:Name="PART_Root"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource ToolButtonCornerRadius}"
							Padding="{TemplateBinding Padding}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Hover" Storyboard.TargetProperty="Opacity">
											<DiscreteDoubleKeyFrame KeyTime="0" Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Hover" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonPressedBackground}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Hover" Storyboard.TargetProperty="Opacity">
											<DiscreteDoubleKeyFrame KeyTime="0" Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonDisabledForeground}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Icon" Storyboard.TargetProperty="Opacity">
											<DiscreteDoubleKeyFrame KeyTime="0" Value="0.4" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="CheckStates">
								<VisualState x:Name="Unchecked" />
								<VisualState x:Name="Checked">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Root" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonCheckedBackground}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonCheckedForeground}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Hover" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonCheckedHoverBackground}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid>
							<!-- A separate hover layer, so a checked button can be hovered without
							     losing the colour that says it is checked. -->
							<Border x:Name="PART_Hover"
									Background="{ThemeResource ToolButtonHoverBackground}"
									CornerRadius="{StaticResource ToolButtonCornerRadius}"
									Opacity="0" />
							<StackPanel x:Name="PART_Layout"
										Orientation="{TemplateBinding LabelOrientation}"
										Spacing="{StaticResource ToolBarLabelSpacing}"
										HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
								<ContentPresenter x:Name="PART_Icon"
												  Content="{TemplateBinding IconVisual}"
												  Visibility="{TemplateBinding IconVisibility}"
												  Width="{TemplateBinding EffectiveIconSize}"
												  Height="{TemplateBinding EffectiveIconSize}"
												  HorizontalAlignment="Center"
												  VerticalAlignment="Center" />
								<TextBlock x:Name="PART_Text"
										   Text="{TemplateBinding ResolvedText}"
										   Visibility="{TemplateBinding TextVisibility}"
										   Foreground="{TemplateBinding Foreground}"
										   FontSize="{StaticResource ToolBarLabelFontSize}"
										   TextAlignment="Center"
										   VerticalAlignment="Center" />
							</StackPanel>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="cb:ToolToggleButton" BasedOn="{StaticResource DefaultToolToggleButtonStyle}" />

	<!-- Two parts, not two nested buttons: the arrow is an ordinary element and the button decides
	     which half a press landed on. Nesting a second button inside a button would give the inner
	     one its own focus, its own tab stop and its own theme, none of which a tool bar wants. -->
	<Style x:Key="DefaultToolDropDownButtonStyle" TargetType="cb:ToolDropDownButton"
		   BasedOn="{StaticResource DefaultToolButtonStyle}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="cb:ToolDropDownButton">
					<Border x:Name="PART_Root"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{StaticResource ToolButtonCornerRadius}"
							Padding="{TemplateBinding Padding}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Root" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonHoverBackground}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonHoverForeground}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Root" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonPressedBackground}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolButtonDisabledForeground}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Icon" Storyboard.TargetProperty="Opacity">
											<DiscreteDoubleKeyFrame KeyTime="0" Value="0.4" />
										</DoubleAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Arrow" Storyboard.TargetProperty="Opacity">
											<DiscreteDoubleKeyFrame KeyTime="0" Value="0.4" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel x:Name="PART_Layout"
										Grid.Column="0"
										Orientation="{TemplateBinding LabelOrientation}"
										Spacing="{StaticResource ToolBarLabelSpacing}"
										HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
								<ContentPresenter x:Name="PART_Icon"
												  Content="{TemplateBinding IconVisual}"
												  Visibility="{TemplateBinding IconVisibility}"
												  Width="{TemplateBinding EffectiveIconSize}"
												  Height="{TemplateBinding EffectiveIconSize}"
												  HorizontalAlignment="Center"
												  VerticalAlignment="Center" />
								<TextBlock x:Name="PART_Text"
										   Text="{TemplateBinding ResolvedText}"
										   Visibility="{TemplateBinding TextVisibility}"
										   Foreground="{TemplateBinding Foreground}"
										   FontSize="{StaticResource ToolBarLabelFontSize}"
										   TextAlignment="Center"
										   VerticalAlignment="Center" />
							</StackPanel>
							<Grid x:Name="PART_Arrow"
								  Grid.Column="1"
								  MinWidth="16"
								  Margin="4,0,0,0"
								  Visibility="{TemplateBinding ArrowVisibility}">
								<Rectangle Width="1"
										   Margin="0,2,4,2"
										   HorizontalAlignment="Left"
										   VerticalAlignment="Stretch"
										   Fill="{ThemeResource ToolDropDownPartSeparatorBrush}" />
								<Path Data="M 0 0 L 7 0 L 3.5 4.5 Z"
									  Margin="4,0,0,0"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center"
									  Fill="{ThemeResource ToolDropDownArrowBrush}" />
							</Grid>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="cb:ToolDropDownButton" BasedOn="{StaticResource DefaultToolDropDownButtonStyle}" />

	<!-- ===== END BUTTONS styles ===== -->

	<!-- ===== BEGIN ICONS styles =====
	     Owned by the ICONS stream: anything SvgIcon / RasterIcon / GlyphIcon need
	     in the visual tree. Empty in the scaffold. -->
	<!-- ===== END ICONS styles ===== -->

</ResourceDictionary>
