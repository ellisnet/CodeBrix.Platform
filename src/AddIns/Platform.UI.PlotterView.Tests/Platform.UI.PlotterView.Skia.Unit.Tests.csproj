<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>

		<!-- xUnit.net v3 test projects are self-executing binaries and must build as Exe;
		     run via Microsoft.Testing.Platform, matching the CodeBrix family test convention. -->
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

		<!-- The add-in binds the Skia flavour of Platform.UI (like the TerminalView and
		     TextLayout suites), so this suite does too. Unlike those suites nothing here
		     shapes or rasterizes text - every test targets pure input/geometry logic - so no
		     Skia/HarfBuzz natives and no ICU data are needed. -->
		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>

		<AssemblyName>CodeBrix.Platform.UI.PlotterView.Unit.Tests</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.PlotterView.Tests</RootNamespace>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="xunit.v3" Version="4.0.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI.PlotterView\Platform.UI.PlotterView.Skia.csproj" />
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
	</ItemGroup>

</Project>
