<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.TerminalView.Core: the terminal control (TerminalControl) and its grid drawing on an
	SKCanvas, the input mapping, the selection geometry and the text runs laid out through the TextLayout add-in's
	Core - the shared tree of this folder. It references SkiaSharp (plan rule R7), CodeBrix.Terminal, the RobotoMono
	font package, the TextLayout Core and the framework's Core assemblies, never the framework's Skia assemblies. The
	element that supplies the canvas is the platform contract Contracts/IRenderCanvasPlatform.cs; the Skia project in
	this folder (Platform.UI.TerminalView.Skia.csproj, assembly CodeBrix.Platform.UI.TerminalView) implements it and
	carries the package.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.TerminalView.Core</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.TerminalView</RootNamespace>

		<CodeBrixRuntimeIdentifier>Core</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Ships inside the TerminalView package (the Skia project bundles it); there is no package of its own. -->
		<IsPackable>false</IsPackable>

		<!-- The add-in ships its IntelliSense text: the .xml lands beside the dll in the build
		     output and the Skia project packs it beside this dll, so nothing in the packaging
		     recipe needs to know about it. CS1591 (a public member with no XML comment) is fixed at
		     source rather than suppressed - the comment IS the deliverable here. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Core.csproj" />
		<ProjectReference Include="..\Platform.UI.TextLayout\Platform.UI.TextLayout.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The same three packages the Skia project references (it declares them for the package);
		     keep the versions in step with it. -->
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="CodeBrix.Terminal.MitLicenseForever" Version="1.0.262.971" />
		<PackageReference Include="CodeBrix.Platform.Fonts.RobotoMono.OflLicenseForever" Version="1.0.248.1223" />
	</ItemGroup>

	<!-- Trimmable and AOT-compatible (WPE1 C1): IsAotCompatible implies IsTrimmable (the IsTrimmable assembly
	     metadata) and turns on the trim, AOT and single-file analyzers, whose findings are fixed at source. -->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<!-- Roots the Skia twin in trimmed Skia apps (WPE1 C1); see the comment in the file. -->
	<ItemGroup>
		<EmbeddedResource Include="ILLink.Descriptors.xml">
			<LogicalName>ILLink.Descriptors.xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
