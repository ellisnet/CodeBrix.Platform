<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.AudioPlayer.Core: the control API and the playback state of the AudioPlayer element (its
	dependency properties, the position timer, the debounced seek-on-release, the failure event), the SoundEffect
	API with its caches, and the audio source resolver (file path, ms-appx:///, embedded://) - the shared tree of this
	folder. It references only the platform-neutral framework Core assemblies and no audio engine. The sound itself
	is the platform's, behind the contracts Contracts/IAudioPlayerPlatform.cs (one output per element) and
	Contracts/IAudioOutputPlatform.cs (the shared effect voices and the failure explanation); the Skia project in
	this folder (Platform.UI.AudioPlayer.Skia.csproj, assembly CodeBrix.Platform.UI.AudioPlayer.Skia) implements them
	over CodeBrix.Audio, holds MidiPlayer (whose public API is made of CodeBrix.Audio types), and carries the
	package.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.AudioPlayer.Core</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.AudioPlayer.Skia</RootNamespace>

		<CodeBrixRuntimeIdentifier>Core</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Ships inside the AudioPlayer package (the Skia project bundles it); there is no package of its own. -->
		<IsPackable>false</IsPackable>

		<!-- The add-in ships its IntelliSense text: the .xml lands beside the dll in the build
		     output and the Skia project packs it beside this dll, so nothing in the packaging
		     recipe needs to know about it. CS1591 (a public member with no XML comment) is fixed at
		     source rather than suppressed - the comment IS the deliverable here. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Core.csproj" />
		<ProjectReference Include="..\..\CodeBrix.Platform.Extensions.Logging\CodeBrix.Platform.Extensions.Logging.Core.csproj" />
	</ItemGroup>
	<!-- Trimmable and AOT-compatible (WPE1 C1): IsAotCompatible implies IsTrimmable (the IsTrimmable assembly
	     metadata) and turns on the trim, AOT and single-file analyzers, whose findings are fixed at source. -->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<!-- Roots the Skia twin in trimmed Skia apps (WPE1 C1); see the comment in the file. -->
	<ItemGroup>
		<EmbeddedResource Include="ILLink.Descriptors.xml">
			<LogicalName>ILLink.Descriptors.xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
