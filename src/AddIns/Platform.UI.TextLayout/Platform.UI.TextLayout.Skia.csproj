<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.TextLayout</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.TextLayout</RootNamespace>

		<!-- This AddIn is packed by the central driver (build/CodeBrix.Platform.Build.csproj, the
		     _CsprojPackage list), which date-stamps it and drops it in {repo}/nugets/Release with
		     the rest of the family - so no GeneratePackageOnBuild here. -->
		<!-- Ships the standard CodeBrix doc set (icon, README, AGENT-README, THIRD-PARTY-NOTICES) as
		     package content via the ItemGroup below, matching the AudioPlayer add-in's configuration. -->
		<PackageIcon>icon-codebrix-128.png</PackageIcon>
		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'=='false'">CodeBrix.Platform.TextLayout.ApacheLicenseForever</PackageId>
		<Description>Advanced text layout and measurement for building your own text-heavy control, with no XAML or application host required. Shapes and measures text using the same HarfBuzz-based engine used throughout the toolkit, including support for right-to-left and mixed-direction text. Draws directly onto a drawing surface, so you can use it for anything from a custom editor to exporting text into a document.</Description>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<!-- SkiaSharp supplies the public surface's geometry types (SKRect, SKPath, SKCanvas).
		     SkiaSharp.HarfBuzz is referenced family-wide so a consumer cannot pull it in at a version
		     that disagrees with the pinned SkiaSharp; both versions come from the PackageReference
		     Update entries in src/Directory.Build.targets. -->
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.HarfBuzz" />
		<PackageReference Include="HarfBuzzSharp" />
	</ItemGroup>

	<ItemGroup>
		<!-- ICU, and the reason this add-in can honour "no application host required" on every
		     platform rather than only on Linux. Linux gets ICU from the dynamic linker search path,
		     so nothing has to ship; Windows and macOS have no system copy at all, and until these
		     packages are here a consumer with no head fails on the very first layout call with
		     "Failed to load libicuuc." An application head already pulls the same packages in
		     through its runtime package, where the shared version pin makes this a no-op.

		     Referenced unconditionally, not per-OS: a NuGet dependency is chosen at restore time
		     and has to hold for every platform the consumer builds for. The natives sit under
		     runtimes/<rid>/native, so a build for one platform never loads the other's. Versions
		     match Runtime.Skia.Win32 and Runtime.Skia.MacOS, which reference the same packages -
		     the family resolves one version of each. -->
		<PackageReference Include="CodeBrix.Platform.Unicode.ApacheLicenseForever" Version="1.0.242.1407" />
		<PackageReference Include="CodeBrix.Platform.UnicodeMacOs.ApacheLicenseForever" Version="1.0.242.1407" />
	</ItemGroup>

	<ItemGroup>
		<!-- Platform.UI.Skia packs as the CodeBrix.Platform.ApacheLicenseForever dependency, at the
		     same family version as this build (the whole family ships together). The add-in reaches
		     the layout engine through InternalsVisibleTo, declared in src/Platform.UI/AssemblyInfo.cs. -->
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
