<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.WebGpu.Skia: the *.skia.cs files - the WebGpuRenderView element (its public API is made of
	CodeBrix.WebGpu.Native and SkiaSharp types, so it lives with that dependency), IWebGpuRenderer, WebGpuFrame, the
	render/overlay/device-ready event args, the native-module hand-off struct, the Readback presenter, the surface
	painter, the frame timer the Core's scheduler runs on, and the bootstrap that registers this assembly's
	implementations of the Core's platform contracts - and the package. The element's rules, the frame scheduler and
	the enums/event args that name no WebGPU type are in CodeBrix.Platform.UI.WebGpu.Core
	(Platform.UI.WebGpu.Core.csproj), which this package carries beside this assembly.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.WebGpu.Skia</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.WebGpu</RootNamespace>

		<!-- This AddIn is packed by the central driver (build/CodeBrix.Platform.Build.csproj, the
		     _CsprojPackage list), which date-stamps it and drops it in {repo}/nugets/Release with
		     the rest of the family - so no GeneratePackageOnBuild here. -->
		<!-- Ships the standard CodeBrix doc set (icon, README, AGENT-README, THIRD-PARTY-NOTICES) as
		     package content via the ItemGroup below, matching the VideoPlayer add-in's configuration,
		     except that the README packed is the add-in's OWN README.md (a consumer page about the view)
		     rather than the repository's. -->
		<PackageIcon>icon-codebrix-128.png</PackageIcon>
		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'=='false'">CodeBrix.Platform.WebGpu.ApacheLicenseForever</PackageId>
		<Description>Adds a WebGPU render view to your app: put a WebGpuRenderView in a page, handle its Render event (or give it an IWebGpuRenderer), and record WebGPU commands into the frame it hands you. It works on every Skia head, owns its GPU device, and can run continuously at a target frame rate, render only when invalidated, or be driven frame by frame from any thread you choose. A SkiaSharp overlay draws HUD text and shapes over each frame, and the view shares its device and texture with other WebGPU libraries and with native (Rust, C, C++) modules through the CodeBrix.WebGpu hand-off contracts.</Description>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Only the Skia files: the shared tree belongs to Platform.UI.WebGpu.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<!-- Recording WebGPU commands takes pointers to descriptor structs, and the native-module hand-off is a
		     blittable struct with unmanaged function pointers. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- The family's one SkiaSharp ($(SkiaSharpVersion) in src/Directory.Build.targets). The overlay hands the
		     application an SKCanvas, and the Readback presenter wraps the read-back pixels as SKImages. -->
		<PackageReference Include="SkiaSharp" />

		<!-- The WebGPU side: CodeBrix.WebGpu.Skia owns the device (WebGpuSkiaDevice) and the off-screen target
		     (WebGpuSkiaTarget) and brings CodeBrix.WebGpu.Native - the raw binding, the wgpu engine's natives for
		     every runtime identifier, the sharing contracts the view implements and the native-module hand-off
		     structs. It requires exactly the SkiaSharp this family pins, so the two never disagree. NEVER add
		     CodeBrix.WebGpu.Graphics here: that higher layer is the APPLICATION's choice, and it composes with the
		     view through the sharing contracts (IWebGpuDeviceSource, IWebGpuTextureTarget) without this package
		     knowing it exists. -->
		<PackageReference Include="CodeBrix.WebGpu.Skia.MitLicenseForever" Version="1.0.287.390" />

		<!-- Platform.UI.Skia packs as the CodeBrix.Platform.ApacheLicenseForever dependency, at the same family
		     version as this build (the whole family ships together). Extensions.Logging is PrivateAssets="all"
		     because it has no standalone nuget - its assembly ships inside the main framework package. -->
		<!-- The add-in's Core assembly ships INSIDE this package (CodeBrixBundleInPackage, see
		     ../AddIn.CorePackaging.targets): not a package dependency, the same nupkg. -->
		<ProjectReference Include="Platform.UI.WebGpu.Core.csproj" CodeBrixBundleInPackage="true" />

		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
		<ProjectReference Include="..\..\CodeBrix.Platform.Extensions.Logging\CodeBrix.Platform.Extensions.Logging.Core.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<!-- Its own README.md (also the nuget readme, PackageReadmeFile=README.md from src/Directory.Build.props) and
		     consumer guide, not the repository-wide README. -->
		<None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<!-- The add-in ships its IntelliSense text: the .xml lands beside the dll in the build
		     output and `dotnet pack` puts it in the package's lib folder by itself (the Core
		     assembly's beside it, through ../AddIn.CorePackaging.targets), so nothing in the
		     packaging recipe needs to know about it. CS1591 (a public member with no XML
		     comment) is fixed at source rather than suppressed - the comment IS the deliverable. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<Import Project="..\AddIn.CorePackaging.targets" />
</Project>
