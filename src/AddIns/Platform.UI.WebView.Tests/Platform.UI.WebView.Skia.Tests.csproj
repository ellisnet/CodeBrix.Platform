<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>

		<!-- xUnit.net v3 test projects are self-executing binaries and must build as Exe;
		     run via Microsoft.Testing.Platform, matching the CodeBrix family test convention. -->
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

		<!-- Host-free: the suite drives the add-in's pure script text (the host-to-page message channel and the
		     delivery scripts, via InternalsVisibleTo) - no web engine, no window. The page-side behaviour is
		     proven against the real engine by the WebView UIReqs. -->
		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>

		<AssemblyName>CodeBrix.Platform.UI.WebView.Tests</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.WebView.Tests</RootNamespace>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI.WebView.Skia\Platform.UI.WebView.Skia.csproj" />
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
	</ItemGroup>

</Project>
