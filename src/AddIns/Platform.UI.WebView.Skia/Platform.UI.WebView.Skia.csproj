<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.WebView.Skia</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.WebView.Skia</RootNamespace>

		<!-- This AddIn is packed by the central driver (build/CodeBrix.Platform.Build.csproj, the
		     _CsprojPackage list), which date-stamps it and drops it in {repo}/nugets/Release with
		     the rest of the family - so no GeneratePackageOnBuild here. -->
		<!-- Ships the standard CodeBrix doc set (icon, README, AGENT-README, THIRD-PARTY-NOTICES) as
		     package content via the ItemGroup below. The packed root README.md also serves as the
		     nuget readme (PackageReadmeFile=README.md inherited from src/Directory.Build.props),
		     matching the Lottie package's configuration. -->
		<PackageIcon>icon-codebrix-128.png</PackageIcon>
		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'=='false'">CodeBrix.Platform.WebView.ApacheLicenseForever</PackageId>
		<Description>WebView support for CodeBrix.Platform Skia apps. Reference it once in your app's .Core project and the XAML WebView2 control works on every head: Windows (Win32), Skia-on-WPF, Linux (X11, Wayland, FrameBuffer), and macOS. Linux heads require the system WPE WebKit engine.</Description>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />

		<!-- Platform.UI.Skia packs as the CodeBrix.Platform.ApacheLicenseForever dependency, at the
		     same family version as this build (the whole family ships together). Extensions.Logging is
		     PrivateAssets="all" because it has no standalone nuget - its assembly ships inside the main
		     framework package. -->
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
		<ProjectReference Include="..\..\CodeBrix.Platform.Extensions.Logging\CodeBrix.Platform.Extensions.Logging.csproj" PrivateAssets="all" />

		<!-- Pack-time ONLY: locates the Microsoft Edge WebView2 redistributable so its runtime assets
		     can be bundled into this package (see the buildTransitive .targets and the ItemGroup below).
		     ExcludeAssets="all" so nothing is referenced or copied into THIS (Linux) add-on's own build;
		     PrivateAssets="all" so it never flows to consumers as a dependency. Version comes from the
		     PackageReference Update in src/Directory.Build.targets, matching the runtime packages. -->
		<PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
	</ItemGroup>

	<!-- Auto-imported into consuming heads by NuGet (file name must equal the package id). Packed as
	     Content (not None) so it does not collide with the SDK's default None glob for this in-project
	     file - matches how the runtime packages pack their buildTransitive files. -->
	<ItemGroup>
		<Content Include="buildTransitive\CodeBrix.Platform.WebView.ApacheLicenseForever.targets">
			<Pack>true</Pack>
			<PackagePath>buildTransitive\CodeBrix.Platform.WebView.ApacheLicenseForever.targets</PackagePath>
		</Content>
	</ItemGroup>

	<!--
		Bundle the Microsoft Edge WebView2 runtime redistributable into buildTransitive\webview2 so the
		Windows heads (Skia.Win32 / Skia.Wpf) can copy it to their output. The variants match what
		Microsoft.Web.WebView2's own build/Common.targets selects for net5.0+ managed heads (Core and
		WinForms from netcoreapp3.0, Wpf from net5.0-windows) plus the three native loaders.

		This runs via TargetsForTfmSpecificContentInPackage (the per-TFM INNER build) because
		$(PkgMicrosoft_Web_WebView2) - from GeneratePathProperty on the pack-time-only PackageReference
		above - is only defined in the inner build, not the outer build where a static pack ItemGroup
		would evaluate it (this project multi-targets via $(NetSkiaPreviousAndCurrent)). The payload is
		packed only; it never enters this add-on's own build output. See THIRD-PARTY-NOTICES.txt for the
		WebView2 redistributable notice.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_CbxAddWebView2Payload</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>
	<Target Name="_CbxAddWebView2Payload">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll">
				<PackagePath>buildTransitive\webview2\Microsoft.Web.WebView2.Core.dll</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll">
				<PackagePath>buildTransitive\webview2\Microsoft.Web.WebView2.WinForms.dll</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(PkgMicrosoft_Web_WebView2)\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll">
				<PackagePath>buildTransitive\webview2\Microsoft.Web.WebView2.Wpf.dll</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll">
				<PackagePath>buildTransitive\webview2\runtimes\win-x64\native\WebView2Loader.dll</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll">
				<PackagePath>buildTransitive\webview2\runtimes\win-x86\native\WebView2Loader.dll</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll">
				<PackagePath>buildTransitive\webview2\runtimes\win-arm64\native\WebView2Loader.dll</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<None Include="..\..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
