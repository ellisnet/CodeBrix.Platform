<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>

		<!-- xUnit.net v3 test projects are self-executing binaries and must build as Exe;
		     run via Microsoft.Testing.Platform, matching the CodeBrix family test convention. -->
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

		<!-- The entire layout engine lives in *.skia.cs files, which Platform.CrossTargetting.targets
		     compiles ONLY into the Skia flavour. A test project on the usual $(NetUnitTests) "Tests"
		     flavour therefore cannot see the engine at all - which is why the repo's existing
		     Platform.UI unit tests never measure text. Binding the Skia flavour is what makes this
		     suite possible. -->
		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>

		<AssemblyName>CodeBrix.Platform.UI.TextLayout.Unit.Tests</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.TextLayout.Tests</RootNamespace>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>

		<!-- No ICU bootstrap here, deliberately. This project used to claim $(IsCodeBrixHead) to make
		     the Unicode package embed icudt.dat, turn the generated module initializer back off, and
		     hand the archive to the engine by reflection from IcuDataInitializer.cs. The add-in now
		     depends on the Unicode packages itself, and those copy icudt.dat beside any non-head Exe,
		     so a plain test project needs none of it. Keeping the bootstrap would also hide the very
		     regression these tests exist to catch: if the host-free path breaks, this suite must be
		     the thing that fails. -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.164.180" />
	</ItemGroup>

	<!-- Skia and HarfBuzz still need their natives named per-OS: those come from the head packages
	     in an application, and there is no head here. ICU is NOT in these lists any more - the
	     TextLayout add-in carries the Unicode packages itself, on every OS. -->
	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !$([MSBuild]::IsOSPlatform('OSX'))">
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="$(SkiaSharpVersion)" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="$(HarfBuzzSharpVersion)" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<PackageReference Include="SkiaSharp.NativeAssets.macos" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.UI.TextLayout\Platform.UI.TextLayout.Skia.csproj" />
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
	</ItemGroup>

</Project>
