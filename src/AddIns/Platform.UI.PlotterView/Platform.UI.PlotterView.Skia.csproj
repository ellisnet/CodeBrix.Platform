<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.PlotterView</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.PlotterView</RootNamespace>

		<!-- This AddIn is packed by the central driver (build/CodeBrix.Platform.Build.csproj, the
		     _CsprojPackage list), which date-stamps it and drops it in {repo}/nugets/Release with
		     the rest of the family - so no GeneratePackageOnBuild here. -->
		<!-- Ships the standard CodeBrix doc set (icon, README, AGENT-README, THIRD-PARTY-NOTICES) as
		     package content via the ItemGroup below, matching the TerminalView add-in's configuration. -->
		<PackageIcon>icon-codebrix-128.png</PackageIcon>
		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'=='false'">CodeBrix.Platform.PlotterView.ApacheLicenseForever</PackageId>
		<Description>Adds an interactive chart control for plotting data in your app, with panning, zooming, and a click-to-inspect data tracker built in. Works with mouse, keyboard, and touch input alike. Supports line, bar, scatter, and dozens of other chart types, plus linear, logarithmic, date-time, and category axes.</Description>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<!-- Platform.UI.Skia packs as the CodeBrix.Platform.ApacheLicenseForever dependency at the
		     same family version as this build (the whole family ships together). Unlike the
		     TerminalView add-in there is no TextLayout reference: CodeBrix.Plotter shapes and
		     measures its own text through SkiaSharp.HarfBuzz, which flows in transitively with the
		     Plotter package below. -->
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- SkiaSharp is versionless: the family-wide lock in src/Directory.Build.targets pins it. -->
		<PackageReference Include="SkiaSharp" />

		<!-- The plotting engine (the CodeBrix port of OxyPlot). External to the CodeBrix.Platform
		     family, so this reference is versioned here (not family-locked); bump deliberately.
		     This version is the first that carries SkiaRenderContext.TypefaceResolver, which the
		     control uses to route ALL chart text through the application's own fonts (the family's
		     no-system-font-fallback rule) - do not downgrade past it. -->
		<PackageReference Include="CodeBrix.Plotter.MitLicenseForever" Version="1.0.242.1416" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
