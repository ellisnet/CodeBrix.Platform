<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.UI.AdvancedTextEdit: since the Core/Skia split, only the canvas supply (the *.skia.cs files: the
	Skia implementation of the add-in's IRenderCanvasPlatform contract, the add-in's software RenderCanvas) and the
	package. The editor itself is in CodeBrix.Platform.UI.AdvancedTextEdit.Core
	(Platform.UI.AdvancedTextEdit.Core.csproj), which this package carries beside this assembly.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.UI.AdvancedTextEdit</AssemblyName>
		<RootNamespace>CodeBrix.Platform.UI.AdvancedTextEdit</RootNamespace>

		<!-- This AddIn is packed by the central driver (build/CodeBrix.Platform.Build.csproj, the
		     _CsprojPackage list), which date-stamps it and drops it in {repo}/nugets/Release with
		     the rest of the family - so no GeneratePackageOnBuild here. -->
		<!-- Ships the standard CodeBrix doc set (icon, README, AGENT-README, THIRD-PARTY-NOTICES) as
		     package content via the ItemGroup below, matching the TextLayout add-in's configuration. -->
		<PackageIcon>icon-codebrix-128.png</PackageIcon>
		<PackageId Condition="'$(CODEBRIX_UWP_BUILD)'=='false'">CodeBrix.Platform.AdvancedTextEdit.ApacheLicenseForever</PackageId>
		<Description>A full-featured code and text editor control for your app, with the kind of editing experience you'd expect from a professional IDE. It includes syntax highlighting, code folding, a completion popup, search, line numbers, and undo/redo, and stays responsive even on very large documents. Text is rendered with the same shaping and layout engine used throughout the toolkit, so it always matches the rest of your UI.</Description>

		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<!-- Only the Skia files: the shared tree belongs to Platform.UI.AdvancedTextEdit.Core.csproj. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="**\*.skia.cs" Exclude="bin\**;obj\**" />
		<UpToDateCheckInput Include="**\*.skia.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<!-- SkiaSharp supplies the geometry and drawing types on the public surface (SKCanvas in
		     background renderers and the render pass, SKRect/SKPoint in layout geometry). Its version
		     comes from the PackageReference Update entries in src/Directory.Build.targets, so it can
		     never disagree with the family-wide pin. -->
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

	<ItemGroup>
		<!-- Platform.UI.Skia packs as the CodeBrix.Platform.ApacheLicenseForever dependency and
		     Platform.UI.TextLayout.Core (the whole TextLayout add-in since the text-engine home change)
		     as the CodeBrix.Platform.TextLayout.ApacheLicenseForever
		     dependency, both at the same family version as this build (the whole family ships
		     together). The editor itself is in the Core project below. -->
		<ProjectReference Include="..\..\Platform.UI\Platform.UI.Skia.csproj" />
		<ProjectReference Include="..\Platform.UI.TextLayout\Platform.UI.TextLayout.Core.csproj" />

		<!-- The add-in's Core assembly ships INSIDE this package (CodeBrixBundleInPackage, see
		     ../AddIn.CorePackaging.targets): not a package dependency, the same nupkg. -->
		<ProjectReference Include="Platform.UI.AdvancedTextEdit.Core.csproj" CodeBrixBundleInPackage="true" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\icon-codebrix-128.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="AGENT-README.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<!-- The add-in ships its IntelliSense text: the .xml lands beside the dll in the build
		     output and `dotnet pack` puts it in the package's lib folder by itself, so nothing in
		     the packaging recipe needs to know about it. CS1591 (a public member with no XML
		     comment) is fixed at source rather than suppressed - the comment IS the deliverable. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<Import Project="..\AddIn.CorePackaging.targets" />
</Project>
