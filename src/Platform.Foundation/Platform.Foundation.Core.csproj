<Project Sdk="Microsoft.NET.Sdk">
	<!--
	CodeBrix.Platform.Foundation.Core: Core by whole (decision P1): nothing in it is platform-specific, so it is renamed
	to .Core and there is no shell assembly under the old name.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../targetframework-override.props" />

	<PropertyGroup>
		<AssemblyName>CodeBrix.Platform.Foundation.Core</AssemblyName>
		<RootNamespace>Windows.Foundation</RootNamespace>

		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>

		<CodeBrixRuntimeIdentifier>Core</CodeBrixRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
		<CommonOverridePackageId>CodeBrix.Platform.Foundation</CommonOverridePackageId>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Platform.Foundation.Logging\Platform.Foundation.Logging.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="LinkerDefinition.netcoremobile.xml">
			<LogicalName>$(AssemblyName).xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<UpToDateCheckInput Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" Visible="False" />
	</ItemGroup>

	<Import Project="..\CodeBrix.Platform.Extensions\CodeBrix.Platform.Extensions.props" />

</Project>
