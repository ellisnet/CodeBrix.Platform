<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
		<SupportsFontManifest>true</SupportsFontManifest>

		<!-- "I am a Windows WebView2-capable head." The WebView add-on
		     (CodeBrix.Platform.WebView.ApacheLicenseForever) keys its Windows WebView2 payload copy
		     off this flag, since TFM cannot distinguish a Skia-on-WPF head from a Linux head (both net10.0). -->
		<CodeBrixWindowsWebViewHost>true</CodeBrixWindowsWebViewHost>
	</PropertyGroup>
</Project>
