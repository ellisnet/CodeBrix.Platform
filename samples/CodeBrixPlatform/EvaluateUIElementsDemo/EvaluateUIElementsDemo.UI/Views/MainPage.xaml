<Page x:Class="EvaluateUIElementsDemo.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:CodeBrix.Platform.UI.Converters"
      x:Name="RootPage"
      NavigationCacheMode="Enabled"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      FontFamily="{StaticResource OpenSansFont}">

  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
  </Page.Resources>

  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Evaluate UI Elements" FontSize="24" FontWeight="Bold" />

    <TextBlock Grid.Row="1" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
               Text="One numbered button per UI element or scenario the frame review rated suspicious. Tap a button, read the message, press OK, then try the element on the page that replaces this one. Use the &lt; Back button to come back here, and report what you saw by number. A green button is a scenario that has already been checked and found good." />

    <!-- The list: an ItemsControl in a ScrollViewer, one row per scenario. The button is bound to the
         page's command through the page's name, which is the shape a DataTemplate needs to reach the
         page's view model; the row's own DataContext is the scenario and rides along as the parameter. -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Scenarios}" Margin="0,4,16,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnSpacing="16" Margin="0,0,0,14" MinHeight="88">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!-- Two buttons share the cell; the row's IsVerified decides which one is shown. The
                   green one keeps its colour in every state by overriding the Button theme resources
                   on the button itself (the same lightweight-styling lever scenario 1 demonstrates). -->
              <Button Content="{Binding Number}" FontSize="26" FontWeight="SemiBold"
                      Width="104" Height="72" VerticalAlignment="Top"
                      Visibility="{Binding IsVerified, Converter={StaticResource InvBoolToVis}}"
                      Command="{Binding DataContext.OpenScenarioCommand, ElementName=RootPage}"
                      CommandParameter="{Binding}" />
              <Button Content="{Binding Number}" FontSize="26" FontWeight="SemiBold"
                      Width="104" Height="72" VerticalAlignment="Top"
                      Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}"
                      Command="{Binding DataContext.OpenScenarioCommand, ElementName=RootPage}"
                      CommandParameter="{Binding}">
                <Button.Resources>
                  <SolidColorBrush x:Key="ButtonBackground" Color="#2E7D32" />
                  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#388E3C" />
                  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1B5E20" />
                  <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1B5E20" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#1B5E20" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1B5E20" />
                </Button.Resources>
              </Button>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Page>
