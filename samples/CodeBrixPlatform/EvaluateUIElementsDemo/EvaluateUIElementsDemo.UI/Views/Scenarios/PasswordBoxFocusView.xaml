<UserControl x:Class="EvaluateUIElementsDemo.Views.Scenarios.PasswordBoxFocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Boxes A and B are the survey's PasswordBox exactly: 500 x 70, FontSize 32, Foreground Blue,
       Background White, BorderThickness 0; B masks with '#'. WinUI's own PasswordBox template
       swaps the same TextControl* theme brushes in while the box is focused or under the pointer
       as the TextBox template does, so A and B change look in those states by design. Box D
       overrides those resources on the box itself. Box C is the default style. -->
  <StackPanel Spacing="10" Padding="4,8,4,8">
    <TextBlock Text="A: the survey's PasswordBox - Foreground Blue, Background White, BorderThickness 0 (WinUI's template swaps in theme brushes while focused or under the pointer)" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" />
    <PasswordBox Width="500" Height="70" FontSize="32" Foreground="Blue" Background="White"
                 BorderThickness="0" Password="Passw0rd" HorizontalAlignment="Left" />

    <TextBlock Text="B: the same PasswordBox with PasswordChar '#'" Margin="0,12,0,0" />
    <PasswordBox Width="500" Height="70" FontSize="32" Foreground="Blue" Background="White"
                 BorderThickness="0" PasswordChar="#" Password="abcdefgh" HorizontalAlignment="Left" />

    <TextBlock Text="C: a PasswordBox with the default style, nothing overridden but FontSize and Width" Margin="0,12,0,0" />
    <PasswordBox Width="500" FontSize="32" Password="hunter2" HorizontalAlignment="Left" />

    <TextBlock Text="D: as A, plus the focused and pointer-over theme resources overridden on the box - must stay Blue on White with no border or underline in every state" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" Margin="0,12,0,0" />
    <PasswordBox Width="500" Height="70" FontSize="32" Foreground="Blue" Background="White"
                 BorderThickness="0" Password="Passw0rd" HorizontalAlignment="Left">
      <PasswordBox.Resources>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Blue" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Blue" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
      </PasswordBox.Resources>
    </PasswordBox>

    <Button Content="Move keyboard focus here" Margin="0,16,0,0" />
  </StackPanel>
</UserControl>
