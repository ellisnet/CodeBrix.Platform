<UserControl x:Class="EvaluateUIElementsDemo.Views.Scenarios.ProgressRingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="16" Padding="4,8,4,8">
    <ToggleSwitch x:Name="ActiveSwitch" Header="IsActive of ring A" IsOn="True" OnContent="Active" OffContent="Inactive" />

    <StackPanel Orientation="Horizontal" Spacing="40">
      <!-- A: the survey's ring - 120 x 120, IsActive following the switch. The grey outline is
           the ring's box, so "draws nothing while inactive" can be seen too. -->
      <StackPanel Spacing="8">
        <TextBlock Text="A: 120 x 120, IsActive from the switch" />
        <Border BorderBrush="LightGray" BorderThickness="1" HorizontalAlignment="Left">
          <ProgressRing x:Name="RingA" Width="120" Height="120" IsActive="{Binding IsOn, ElementName=ActiveSwitch}" />
        </Border>
      </StackPanel>

      <!-- B: a small ring with its own Foreground, always active. -->
      <StackPanel Spacing="8">
        <TextBlock Text="B: 60 x 60, always active, Foreground Red" />
        <Border BorderBrush="LightGray" BorderThickness="1" HorizontalAlignment="Left">
          <ProgressRing Width="60" Height="60" IsActive="True" Foreground="Red" />
        </Border>
      </StackPanel>

      <!-- C: a determinate ring, a fixed arc rather than a spinning one. -->
      <StackPanel Spacing="8">
        <TextBlock Text="C: 120 x 120, determinate, Value 65 of 100" />
        <Border BorderBrush="LightGray" BorderThickness="1" HorizontalAlignment="Left">
          <ProgressRing Width="120" Height="120" IsActive="True" IsIndeterminate="False" Minimum="0" Maximum="100" Value="65" />
        </Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
