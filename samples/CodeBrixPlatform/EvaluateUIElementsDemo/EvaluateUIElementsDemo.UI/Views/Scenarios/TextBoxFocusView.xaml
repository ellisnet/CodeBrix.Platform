<UserControl x:Class="EvaluateUIElementsDemo.Views.Scenarios.TextBoxFocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Boxes A and B are the survey's TextBox exactly: 500 x 70, FontSize 32, Foreground Blue,
       Background White, BorderThickness 0. WinUI's own TextBox template swaps theme brushes in
       while the box is focused (TextControlForegroundFocused, TextControlBackgroundFocused,
       TextControlBorderBrushFocused, TextControlBorderThemeThicknessFocused = 1,1,1,2) and while
       the pointer is over it (TextControlForegroundPointerOver, TextControlBackgroundPointerOver,
       TextControlBorderBrushPointerOver), so A and B change look in those states by design.
       Box D overrides those seven resources on the box itself, which is the WinUI way to keep an
       application's own colours in every state. Box E overrides only the three pointer-over
       resources: it keeps WinUI's focused look but stops the pointer from changing the box, so it
       goes back to Blue on White the moment focus leaves, hovered or not. Box C is the default
       style, for comparison. -->
  <StackPanel Spacing="10" Padding="4,8,4,8">
    <TextBlock Text="A: the survey's TextBox - Foreground Blue, Background White, BorderThickness 0, Text 'Hello' (WinUI's template swaps in theme brushes while focused or under the pointer)" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" />
    <TextBox x:Name="SurveyBox" Width="500" Height="70" FontSize="32" Foreground="Blue" Background="White"
             BorderThickness="0" Text="Hello" HorizontalAlignment="Left" />

    <TextBlock Text="B: the same TextBox, empty, with PlaceholderText 'Type here'" Margin="0,12,0,0" />
    <TextBox Width="500" Height="70" FontSize="32" Foreground="Blue" Background="White"
             BorderThickness="0" PlaceholderText="Type here" HorizontalAlignment="Left" />

    <TextBlock Text="C: a TextBox with the default style, nothing overridden but FontSize and Width" Margin="0,12,0,0" />
    <TextBox Width="500" FontSize="32" Text="Hello" HorizontalAlignment="Left" />

    <TextBlock Text="D: as A, plus the focused and pointer-over theme resources overridden on the box - must stay Blue on White with no border or underline in every state" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" Margin="0,12,0,0" />
    <TextBox x:Name="OverrideBox" Width="500" Height="70" FontSize="32" Foreground="Blue" Background="White"
             BorderThickness="0" Text="Hello" HorizontalAlignment="Left">
      <TextBox.Resources>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Blue" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Blue" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
      </TextBox.Resources>
    </TextBox>

    <TextBlock Text="E: as A, plus only the POINTER-OVER theme resources overridden - keeps the focused look (dark text, border, underline) but must ignore the pointer: Blue on White the moment it loses focus, hovered or not" TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" Margin="0,12,0,0" />
    <TextBox x:Name="HoverProofBox" Width="500" Height="70" FontSize="32" Foreground="Blue" Background="White"
             BorderThickness="0" Text="Hello" HorizontalAlignment="Left">
      <TextBox.Resources>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Blue" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
      </TextBox.Resources>
    </TextBox>

    <Button Content="Move keyboard focus here" Margin="0,16,0,0" />
  </StackPanel>
</UserControl>
