<UserControl x:Class="EvaluateUIElementsDemo.Views.Scenarios.SplitViewOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="12" Padding="4,8,4,8">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Open pane" Click="OpenPane_Click" VerticalAlignment="Bottom" />
      <Button Content="Close pane" Click="ClosePane_Click" VerticalAlignment="Bottom" />
      <ComboBox x:Name="DisplayModeBox" Header="DisplayMode" SelectedIndex="0" MinWidth="170"
                SelectionChanged="DisplayMode_SelectionChanged">
        <ComboBoxItem Content="Overlay" />
        <ComboBoxItem Content="Inline" />
        <ComboBoxItem Content="CompactOverlay" />
        <ComboBoxItem Content="CompactInline" />
      </ComboBox>
      <ComboBox x:Name="DismissModeBox" Header="LightDismissOverlayMode" SelectedIndex="0" MinWidth="170"
                SelectionChanged="DismissMode_SelectionChanged">
        <ComboBoxItem Content="Auto" />
        <ComboBoxItem Content="On" />
        <ComboBoxItem Content="Off" />
      </ComboBox>
      <TextBlock x:Name="PaneState" VerticalAlignment="Bottom" Margin="0,0,0,6" />
    </StackPanel>

    <!-- The survey's SplitView exactly: 800 x 500, a Red pane and Blue content, DisplayMode Overlay
         (the default) and the default OpenPaneLength. The labels are the only addition. -->
    <TextBlock Text="800 x 500, pane painted Red, content painted Blue" />
    <SplitView x:Name="Shell" Width="800" Height="500" HorizontalAlignment="Left" DisplayMode="Overlay"
               PaneOpened="Shell_PaneOpened" PaneClosed="Shell_PaneClosed">
      <SplitView.Pane>
        <Border Background="Red">
          <TextBlock Text="Pane" Foreground="White" Margin="12" />
        </Border>
      </SplitView.Pane>
      <Border Background="Blue">
        <TextBlock Text="Content" Foreground="White" Margin="12" />
      </Border>
    </SplitView>
  </StackPanel>
</UserControl>
