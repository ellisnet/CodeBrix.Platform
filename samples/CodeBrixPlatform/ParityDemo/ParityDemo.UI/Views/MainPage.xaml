<Page x:Class="ParityDemo.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ParityDemo.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      FontFamily="{StaticResource OpenSansFont}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="22" Margin="0,0,0,12"
                   Text="Wayland/X11 Parity Demo — Popups &amp; Flyouts" />

        <!-- The regression surface: every control here rides the shared Popup path that
             P1 diagnosed as failing on the Wayland head. -->
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="12">

            <ComboBox x:Name="TestCombo" Header="ComboBox (dropdown popup)"
                      HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Alpha" />
                <ComboBoxItem Content="Bravo" />
                <ComboBoxItem Content="Charlie" />
                <ComboBoxItem Content="Delta" />
                <ComboBoxItem Content="Echo" />
            </ComboBox>

            <Button x:Name="FlyoutButton" Content="MenuFlyout" HorizontalAlignment="Stretch">
                <Button.Flyout>
                    <MenuFlyout x:Name="TestMenuFlyout">
                        <MenuFlyoutItem Text="First item" Click="MenuItem_Click" />
                        <MenuFlyoutItem Text="Second item" Click="MenuItem_Click" />
                        <MenuFlyoutSubItem Text="Sub-menu">
                            <MenuFlyoutItem Text="Nested item" Click="MenuItem_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Last item" Click="MenuItem_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button x:Name="TooltipButton" Content="Hover me (ToolTip)" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="This is the ToolTip popup." />

            <Button x:Name="DialogButton" Content="ContentDialog" HorizontalAlignment="Stretch"
                    Click="DialogButton_Click" />

            <TextBox x:Name="TestTextBox" Header="TextBox (context menu on right-click)"
                     Text="Select me and right-click" />

            <AutoSuggestBox x:Name="TestSuggestBox" Header="AutoSuggestBox (suggestion popup)"
                            PlaceholderText="Type 'a'..."
                            TextChanged="SuggestBox_TextChanged" />

            <TextBlock Text="Clipboard (P3)" FontSize="14" Margin="0,8,0,0" />
            <Button x:Name="CopyRichButton" Content="Copy rich content" HorizontalAlignment="Stretch"
                    Click="CopyRich_Click" />
            <Button x:Name="PasteInspectButton" Content="Paste &amp; inspect formats" HorizontalAlignment="Stretch"
                    Click="PasteInspect_Click" />

            <TextBlock Text="Drag &amp; drop (P4)" FontSize="14" Margin="0,8,0,0" />
            <Border x:Name="DropZone" AllowDrop="True" Height="70" BorderThickness="2"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                    DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                <TextBlock Text="Drop files or text here" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Window chrome (P5)" FontSize="14" Margin="0,8,0,0" />
            <Button x:Name="ToggleChromeButton" Content="Toggle ExtendContentIntoTitleBar" HorizontalAlignment="Stretch"
                    Click="ToggleChrome_Click" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="MaximizeButton" Content="Maximize" Click="Maximize_Click" />
                <Button x:Name="RestoreButton" Content="Restore" Click="Restore_Click" />
                <Button x:Name="StateButton" Content="State?" Click="PresenterState_Click" />
                <Button x:Name="ActivateButton" Content="Activate()" Click="Activate_Click" />
            </StackPanel>

            <Button x:Name="ClearLogButton" Content="Clear log" HorizontalAlignment="Stretch"
                    Click="ClearLog_Click" />
        </StackPanel>

        <!-- Live diagnostics: window activation events, popup open/close, XamlRoot changes. -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="StatusText" FontSize="14" Margin="0,0,0,8"
                       Text="Diagnostics log" />
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontSize="12" Margin="8"
                               FontFamily="monospace" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
