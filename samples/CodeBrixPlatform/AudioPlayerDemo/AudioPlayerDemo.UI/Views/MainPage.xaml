<Page x:Class="AudioPlayerDemo.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:AudioPlayerDemo.Views"
      xmlns:audio="using:CodeBrix.Platform.UI.AudioPlayer.Skia"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      FontFamily="{StaticResource OpenSansFont}">

    <Page.Resources>
        <local:TimecodeConverter x:Key="Timecode" />
    </Page.Resources>

    <StackPanel Margin="20" Spacing="14" MaxWidth="640">

        <!-- The player: non-visual, declared like any other element. The song is an embedded
             resource in AudioPlayerDemo.Core, addressed exactly like the JustBetweenUs sample
             addresses its SVG and Lottie assets. -->
        <audio:AudioPlayer x:Name="Player"
                           Source="embedded://AudioPlayerDemo.Core/AudioPlayerDemo.Assets.demo_song.mp3"
                           PlaybackEnded="Player_PlaybackEnded"
                           MediaFailed="Player_MediaFailed" />

        <TextBlock Text="AudioPlayer demo" FontSize="24" />

        <!-- Timecode indicator + scrubber. The Slider follows playback through the two-way
             binding, and dragging it seeks the audio (debounced seek-on-release). -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Position, ElementName=Player, Converter={StaticResource Timecode}}"
                       Width="52" VerticalAlignment="Center" />
            <Slider x:Name="Scrubber" Width="420" VerticalAlignment="Center"
                    Maximum="{Binding DurationSeconds, ElementName=Player}"
                    Value="{Binding PositionSeconds, ElementName=Player, Mode=TwoWay}"
                    StepFrequency="0.1" />
            <TextBlock Text="{Binding Duration, ElementName=Player, Converter={StaticResource Timecode}}"
                       Width="52" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Transport -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Play" Click="PlayButton_Click" />
            <Button Content="Pause" Click="PauseButton_Click" />
            <Button Content="Stop" Click="StopButton_Click" />
            <Button Content="Jump to 1:00" Click="JumpButton_Click" />
            <ToggleSwitch x:Name="LoopSwitch" Header="" OnContent="Looping" OffContent="Loop"
                          IsOn="{Binding IsLooping, ElementName=Player, Mode=TwoWay}" />
        </StackPanel>

        <!-- Volume -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Volume" VerticalAlignment="Center" />
            <Slider Width="200" VerticalAlignment="Center" Minimum="0" Maximum="1" StepFrequency="0.01"
                    Value="{Binding Volume, ElementName=Player, Mode=TwoWay}" />
        </StackPanel>

        <!-- Source switching: the same song through the two URI schemes. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Source" VerticalAlignment="Center" />
            <Button Content="embedded://" Click="EmbeddedSourceButton_Click" />
            <Button Content="ms-appx:///" Click="MsAppxSourceButton_Click" />
        </StackPanel>

        <!-- Fire-and-forget sound effects: each press is an overlapping voice in the shared
             output, and they play happily on top of the running song. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Sound effects" VerticalAlignment="Center" />
            <Button Content="Chime" Click="ChimeButton_Click" />
            <Button Content="Click" Click="ClickButton_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />

        <!-- ===== Second player: pick one of the full-length sample songs and a format ===== -->
        <TextBlock Text="Play a sample song" FontSize="20" Margin="0,10,0,0" />

        <!-- Song + format selection. Changing either drop-down stops the second player and loads
             the matching file (one of the four samples/assets/sample_song_*.{wav,mp3} files);
             the user then presses this player's Play button to start it. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Song" VerticalAlignment="Center" />
            <ComboBox x:Name="SongSelector" Width="180" SelectedIndex="0"
                      SelectionChanged="SecondPlayerSelection_Changed">
                <ComboBoxItem Content="Sample Song 1" />
                <ComboBoxItem Content="Sample Song 2" />
            </ComboBox>
            <TextBlock Text="Format" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox x:Name="FormatSelector" Width="140" SelectedIndex="1"
                      SelectionChanged="SecondPlayerSelection_Changed">
                <ComboBoxItem Content="WAV" />
                <ComboBoxItem Content="MP3" />
            </ComboBox>
        </StackPanel>

        <!-- The second player itself: non-visual, driven by the compact transport below. Its
             Source is set from the drop-downs in code-behind. -->
        <audio:AudioPlayer x:Name="Player2"
                           PlaybackEnded="Player2_PlaybackEnded"
                           MediaFailed="Player2_MediaFailed" />

        <!-- Compact transport for the second player: timecode + scrubber. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Position, ElementName=Player2, Converter={StaticResource Timecode}}"
                       Width="52" VerticalAlignment="Center" />
            <Slider Width="420" VerticalAlignment="Center"
                    Maximum="{Binding DurationSeconds, ElementName=Player2}"
                    Value="{Binding PositionSeconds, ElementName=Player2, Mode=TwoWay}"
                    StepFrequency="0.1" />
            <TextBlock Text="{Binding Duration, ElementName=Player2, Converter={StaticResource Timecode}}"
                       Width="52" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Play" Click="Play2Button_Click" />
            <Button Content="Pause" Click="Pause2Button_Click" />
            <Button Content="Stop" Click="Stop2Button_Click" />
        </StackPanel>

        <TextBlock x:Name="Player2Status" Text="Ready" TextWrapping="Wrap" />

    </StackPanel>
</Page>
