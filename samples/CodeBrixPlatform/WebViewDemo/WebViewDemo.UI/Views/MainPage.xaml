<Page x:Class="WebViewDemo.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WebViewDemo.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      FontFamily="{StaticResource OpenSansFont}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="AddressBox" Grid.Column="0" Height="40"
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Text="https://en.wikipedia.org/wiki/Inanna" />
            <Button Grid.Column="1" Margin="8,0,0,0" Height="40"
                    VerticalAlignment="Center" Content="Go" Click="GoButton_Click" />
            <Button Grid.Column="2" Margin="8,0,0,0" Height="40"
                    VerticalAlignment="Center" Content="Back" Click="BackButton_Click" />
            <Button Grid.Column="3" Margin="8,0,0,0" Height="40"
                    VerticalAlignment="Center" Content="Forward" Click="ForwardButton_Click" />
            <!-- Pops a modal ContentDialog (same dimming path as WikipediaPublisher's SimpleDialog)
                 over the WebView2, to verify the WPF-head airspace fix: the WebView must hide while
                 the dialog is up and return when OK is clicked. -->
            <Button Grid.Column="4" Margin="8,0,0,0" Height="40"
                    VerticalAlignment="Center" Content="URL" Click="UrlButton_Click" />
        </Grid>

        <!-- Host-to-page messaging. "Echo page" loads an inline page that listens for 'message'
             events on window.chrome.webview and posts each one straight back; the two Post
             buttons call CoreWebView2.PostWebMessageAsString / PostWebMessageAsJson, and
             WebMessageReceived shows what the page answered. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Height="40" VerticalAlignment="Center" Content="Echo page" Click="EchoPageButton_Click" />
            <Button Height="40" Margin="8,0,0,0" VerticalAlignment="Center" Content="Post string" Click="PostStringButton_Click" />
            <Button Height="40" Margin="8,0,0,0" VerticalAlignment="Center" Content="Post JSON" Click="PostJsonButton_Click" />
            <TextBlock x:Name="MessageText" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="No web message received yet" />
        </StackPanel>

        <WebView2 x:Name="Browser" Grid.Row="2" Margin="0,10,0,10"
                  Source="https://en.wikipedia.org/wiki/Inanna" />

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Ready" />

    </Grid>
</Page>
