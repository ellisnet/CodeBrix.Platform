<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WPF host: the Skia.Wpf runtime package flows a Microsoft.WindowsDesktop.App.WPF
         FrameworkReference, so the SDK requires a Windows target platform (NETSDK1136).
         We do NOT set <UseWPF> — that would make WPF's build targets treat our Uno .xaml
         <Page> items as WPF XAML. WPF is loaded at runtime by the Uno host. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>

    <!-- Runtime identity. Formerly set by the Skia.Wpf runtime package's buildTransitive props. -->
    <CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
    <IsCodeBrixHead Condition="'$(OutputType)'=='Exe' OR '$(OutputType)'=='WinExe'">true</IsCodeBrixHead>

    <!-- CodeBrix.Platform feature defines. The NuGet supplied these via its buildTransitive
         targets (platform.winui.common.targets + the Skia.Wpf runtime targets); this head is
         outside the src tree so it does not inherit them from Directory.Build, hence they are
         set explicitly here. The Skia.Wpf runtime defines HAS_CODEBRIX_SKIA_WPF / __CODEBRIX_SKIA_WPF__
         (where the Win32 head uses the _WIN32 variants). -->
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;__CODEBRIX__;HAS_CODEBRIX_WINUI;__CODEBRIX_WINUI__;WINUI_WINDOWING;CODEBRIX_HAS_FRAMEWORKELEMENT_MEASUREOVERRIDE;CODEBRIX_HAS_NO_IDEPENDENCYOBJECT;CODEBRIX_REFERENCE_API;HAS_CODEBRIX_SKIA;HAS_CODEBRIX_SKIA_WPF;__DESKTOP__;__CODEBRIX_SKIA__;__CODEBRIX_SKIA_WPF__</DefineConstants>

    <!-- MSB3277: benign WindowsBase 4.0.0.0 (ref-pack facade) vs 5.0.0.0 conflict flowing in via
         the Skia runtime's transitive Microsoft.Web.WebView2.Wpf reference. RAR picks the 4.0
         facade for the build; the real WindowsBase 5.x loads at runtime. The platform's own
         runtime csproj NoWarns it for the same reason. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as Uno XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (linked from FileFolderDialogDemo.UI) -->
  <Import Project="..\FileFolderDialogDemo.UI\FileFolderDialogDemo.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\FileFolderDialogDemo.Core\FileFolderDialogDemo.Core.csproj" />
  </ItemGroup>

  <!--
    Platform-specific runtime: Skia-on-WPF backend, formerly the
    CodeBrix.Platform.Runtime.Skia.Wpf.ApacheLicenseForever NuGet. The runtime project carries a
    Microsoft.WindowsDesktop.App.WPF FrameworkReference that flows here (hence the net10.0-windows
    TFM); the Uno WPF host loads the WindowsDesktop framework at runtime. All other platform
    references come transitively via FileFolderDialogDemo.Core.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Platform.UI.Runtime.Skia.Wpf\Platform.UI.Runtime.Skia.Wpf.csproj" />
  </ItemGroup>

  <!--
    XAML source-generator + build-task pipeline. The NuGet flowed this into heads via its
    buildTransitive targets; it does NOT flow across a ProjectReference, so a head that compiles
    .xaml must wire it up directly. Mirrors the repo's own from-source build
    (src/Platform.UI.RuntimeTests/Platform.UI.RuntimeTests.Skia.csproj).
  -->
  <PropertyGroup>
    <CodeBrixUIMSBuildTasksPath>$(MSBuildThisFileDirectory)..\..\..\..\src\SourceGenerators\Platform.UI.Tasks\bin\$(Configuration)_Shadow</CodeBrixUIMSBuildTasksPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(DocsGeneration)'==''">
    <ProjectReference Include="..\..\..\..\src\SourceGenerators\Platform.UI.SourceGenerators\Platform.UI.SourceGenerators.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <UndefineProperties>TargetFramework</UndefineProperties>
    </ProjectReference>
  </ItemGroup>
  <Import Project="..\..\..\..\src\SourceGenerators\Platform.UI.SourceGenerators\Content\Platform.UI.SourceGenerators.props" />
  <Import Project="..\..\..\..\src\SourceGenerators\Platform.UI.Tasks\Content\Platform.UI.Tasks.targets" Condition="'$(SkipCodeBrixResourceGeneration)' == '' " />

</Project>
