<Page x:Class="MediaPlayerDemo.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MediaPlayerDemo.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      FontFamily="{StaticResource OpenSansFont}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="AddressBox" Grid.Column="0" Height="40"
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Text="https://download.blender.org/peach/bigbuckbunny_movies/BigBuckBunny_320x180.mp4" />
            <Button Grid.Column="1" Margin="8,0,0,0" Height="40"
                    VerticalAlignment="Center" Content="Load" Click="LoadButton_Click" />
            <ComboBox x:Name="StretchBox" Grid.Column="2" Margin="8,0,0,0" Height="40"
                      VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="StretchBox_SelectionChanged">
                <ComboBoxItem Content="Uniform" />
                <ComboBoxItem Content="UniformToFill" />
                <ComboBoxItem Content="Fill" />
                <ComboBoxItem Content="None" />
            </ComboBox>
        </Grid>

        <MediaPlayerElement x:Name="Player" Grid.Row="1" Margin="0,10,0,10"
                            AutoPlay="True"
                            AreTransportControlsEnabled="True"
                            Stretch="Uniform" />

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" />

    </Grid>
</Page>
