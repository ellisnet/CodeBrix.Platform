<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org only - replaces the CodeBrix.Platform repository's NuGet.Config (which adds a local package
  cache), so every CodeBrix.Platform package here is the one published on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
