<Project Sdk="Microsoft.NET.Sdk">
  <!-- The demo launched WITHOUT WebGPU (PlayTestOptions.WebGpu = Unavailable). WebGPU is a launch option and
       PlayTest runs one application per process, so the application's no-WebGPU path is tested in a process of its
       own: this project. The provider is still registered, as in WebGpuDemo.PlayTests - an opted-out launch ignores
       it. -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <CodeBrixPlayTestPreferredOrientation Condition="'$(CodeBrixPlayTestPreferredOrientation)' == ''">Landscape</CodeBrixPlayTestPreferredOrientation>
    <CodeBrixPlayTestPreferredTheme Condition="'$(CodeBrixPlayTestPreferredTheme)' == ''">Light</CodeBrixPlayTestPreferredTheme>
  </PropertyGroup>
  <Import Project="../../WebGpuDemo.Head.targets" />
  <ItemGroup>
    <ProjectReference Include="$(WebGpuDemoPlatformSource)Platform.UI.Runtime.Skia.PlayTest/Platform.UI.Runtime.Skia.PlayTest.csproj" />
    <ProjectReference Include="$(WebGpuDemoPlatformSource)Platform.UI.Runtime.Skia.PlayTest.WebGpu/Platform.UI.Runtime.Skia.PlayTest.WebGpu.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
  </ItemGroup>
  <Import Project="$(WebGpuDemoPlatformSource)Platform.UI.Runtime.Skia.PlayTest/buildTransitive/CodeBrix.Platform.PlayTest.ApacheLicenseForever.targets" />
</Project>
