<UserControl x:Class="PlayTestDemo.Views.ApiLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PlayTestDemo.Views">
  <Grid Padding="24" ColumnSpacing="24" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.ColumnSpan="3" Text="PlayTest API lab" FontSize="28" FontWeight="SemiBold" />

    <StackPanel Grid.Row="1" Spacing="10">
      <TextBlock Text="Held keys" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Click the box, then hold the right arrow key. The box samples key state on a timer, like a game loop."
                 TextWrapping="Wrap" />
      <local:KeySampler x:Name="Sampler" Height="48" AutomationProperties.AutomationId="KeySampler"
                        AutomationProperties.Name="Key sampler" />
      <TextBlock x:Name="KeyStatus" Text="Right arrow up · 0 samples down" AutomationProperties.AutomationId="KeyStatus" />

      <TextBlock Text="Hidden elements" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Twin label" AutomationProperties.AutomationId="VisibleTwin" />
      <TextBlock Text="Twin label" Visibility="Collapsed" AutomationProperties.AutomationId="HiddenTwin" />
      <StackPanel x:Name="CollapsedPanel" Visibility="Collapsed">
        <Button Content="Hidden action" AutomationProperties.AutomationId="HiddenAction" />
      </StackPanel>

      <TextBlock Text="Strictness while waiting" FontSize="20" FontWeight="SemiBold" />
      <Button Content="Replace the status" Click="OnReplaceStatus" />
      <StackPanel x:Name="ReplacementHost" Spacing="4">
        <TextBlock Text="Status ready" AutomationProperties.AutomationId="ReplacedStatus" />
      </StackPanel>
      <TextBlock Text="Duplicate label" />
      <TextBlock Text="Duplicate label" />

      <TextBlock Text="Disabled container" FontSize="20" FontWeight="SemiBold" />
      <ContentControl IsEnabled="False">
        <Button Content="Inside a disabled control" AutomationProperties.AutomationId="InsideDisabledControl" />
      </ContentControl>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="10">
      <TextBlock Text="Mouse wheel" FontSize="20" FontWeight="SemiBold" />
      <ScrollViewer x:Name="WheelScroll" Height="200" VerticalScrollBarVisibility="Visible"
                    AutomationProperties.AutomationId="WheelScroll">
        <StackPanel x:Name="WheelRows" Spacing="4" Padding="0,0,24,0" />
      </ScrollViewer>

      <TextBlock Text="Selecting options" FontSize="20" FontWeight="SemiBold" />
      <ComboBox x:Name="RowCombo" PlaceholderText="Choose a row" MinWidth="200" SelectionChanged="OnRowSelected"
                AutomationProperties.AutomationId="RowCombo" AutomationProperties.Name="Row" />
      <TextBlock x:Name="RowStatus" Text="No row selected" AutomationProperties.AutomationId="RowStatus" />
      <ListView x:Name="ColorList" SelectionMode="Multiple" Height="180" SelectionChanged="OnColorsSelected"
                AutomationProperties.AutomationId="ColorList" AutomationProperties.Name="Colors" />
      <TextBlock x:Name="ColorStatus" Text="No colors selected" AutomationProperties.AutomationId="ColorStatus" />

      <TextBlock Text="Dialogs" FontSize="20" FontWeight="SemiBold" />
      <Button Content="Delete file" Click="OnDeleteFile" />
      <TextBlock x:Name="DialogStatus" Text="Nothing deleted" AutomationProperties.AutomationId="DialogStatus" />
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="10">
      <TextBlock Text="Launching" FontSize="20" FontWeight="SemiBold" />
      <HyperlinkButton Content="Project website" NavigateUri="https://example.com/playtest-demo" />
      <Button Content="Open report" Click="OnOpenReport" />
      <TextBlock x:Name="LaunchStatus" Text="Nothing launched" AutomationProperties.AutomationId="LaunchStatus" />

      <TextBlock Text="Window" FontSize="20" FontWeight="SemiBold" />
      <CheckBox x:Name="KeepOpen" Content="Unsaved changes (refuse to close)" Checked="OnKeepOpenChanged" Unchecked="OnKeepOpenChanged" />
      <TextBlock x:Name="WindowStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="WindowStatus" />

      <TextBlock Text="Screenshots" FontSize="20" FontWeight="SemiBold" />
      <Border x:Name="Swatch" Width="160" Height="80" HorizontalAlignment="Left" AutomationProperties.AutomationId="Swatch">
        <Border.Background>
          <SolidColorBrush x:Name="SwatchBrush" Color="#2E7D32" />
        </Border.Background>
        <Border Width="40" Height="40" Background="#FFFFFF" />
      </Border>
      <Button Content="Recolor the swatch" Click="OnRecolor" />
    </StackPanel>
  </Grid>
</UserControl>
