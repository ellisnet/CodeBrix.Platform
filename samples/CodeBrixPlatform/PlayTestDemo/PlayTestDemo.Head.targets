<Project>
  <!-- Like the other in-repository demos, consume framework source rather than NuGets.
       ProjectReference does not import the package's XAML/runtime buildTransitive wiring. -->
  <PropertyGroup>
    <PlayTestDemoPlatformSource>$(MSBuildThisFileDirectory)../../../src/</PlayTestDemoPlatformSource>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CodeBrixRuntimeIdentifier>Skia</CodeBrixRuntimeIdentifier>
    <IsCodeBrixHead>true</IsCodeBrixHead>
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;__CODEBRIX__;HAS_CODEBRIX_WINUI;__CODEBRIX_WINUI__;WINUI_WINDOWING;CODEBRIX_HAS_FRAMEWORKELEMENT_MEASUREOVERRIDE;CODEBRIX_HAS_NO_IDEPENDENCYOBJECT;CODEBRIX_REFERENCE_API;HAS_CODEBRIX_SKIA;__DESKTOP__;__CODEBRIX_SKIA__</DefineConstants>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <CodeBrixUIMSBuildTasksPath>$(PlayTestDemoPlatformSource)SourceGenerators/Platform.UI.Tasks/bin/$(Configuration)_Shadow</CodeBrixUIMSBuildTasksPath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)src/PlayTestDemo.UI/PlayTestDemo.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/PlayTestDemo.Core/PlayTestDemo.Core.csproj" />
    <ProjectReference Include="$(PlayTestDemoPlatformSource)SourceGenerators/Platform.UI.SourceGenerators/Platform.UI.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" UndefineProperties="TargetFramework" />
  </ItemGroup>
  <Import Project="$(PlayTestDemoPlatformSource)SourceGenerators/Platform.UI.SourceGenerators/Content/Platform.UI.SourceGenerators.props" />
  <Import Project="$(PlayTestDemoPlatformSource)SourceGenerators/Platform.UI.Tasks/Content/Platform.UI.Tasks.targets" Condition="'$(SkipCodeBrixResourceGeneration)' == ''" />
</Project>
