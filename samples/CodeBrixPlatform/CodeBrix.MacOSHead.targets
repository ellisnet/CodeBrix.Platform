<Project>

  <!--
    Shared build logic for the CodeBrix.Platform macOS sample heads (the *.MacOS heads under
    samples/CodeBrixPlatform). These heads consume the platform from source via ProjectReference
    instead of the NuGet packages, so two things the NuGet normally provides must be reproduced
    here. Rather than copy this into every head, each *.MacOS.csproj imports this one file:

        <Import Project="..\..\CodeBrix.MacOSHead.targets" />

    A new macOS sample head only needs that single import line to pick up both fixes.

    GATING: this file is imported only by the *.MacOS heads, and every target below is additionally
    gated on $(_IsCodeBrixMacOSHead) (project name ends with ".MacOS"). So even if this file were
    imported by a non-macOS head by mistake, it would be inert. Nothing here affects the Win32 /
    Wpf / X11 / Wayland / WinUI heads, which never import it.

    Paths are relative to THIS file's directory (samples/CodeBrixPlatform), so "..\..\src" is the
    repo's src tree (two levels up), not the four levels a head folder would need.
  -->

  <PropertyGroup>
    <_IsCodeBrixMacOSHead Condition="$(MSBuildProjectName.EndsWith('.MacOS'))">true</_IsCodeBrixMacOSHead>
  </PropertyGroup>

  <!--
    Runtime-replace, reproduced (build-integrated). Before the Core/Skia split, Platform.UI.Skia compiled
    against the .Reference WinRT projection and the .Reference Composition/Dispatching layers, and this
    target swapped the .Skia implementations into the copy-local list in their place.

    Since the split there is no .Reference flavor: every framework library is a platform-neutral
    CodeBrix.Platform*.Core.dll (built once, from its *.Core.csproj) plus, for the libraries that have
    Skia code, a Skia twin under the old assembly name (CodeBrix.Platform, .UI, .UI.Composition,
    .UI.Dispatching, .UI.Toolkit). Reference resolution now puts the Skia twins in the copy-local list
    directly, so the swap below re-adds the very files it removes; it is kept (inert) so this file keeps
    working unchanged for a head that still resolves an older build. Foundation is Core by whole
    (CodeBrix.Platform.Foundation.Core.dll, whose AssemblyInfo carries the Runtime.Skia.MacOS grant), so it
    is no longer swapped.
    NOTE (WPB1): this file cannot be built on Linux; it was edited by inspection.
  -->
  <Target Name="_CodeBrixMacOSUseSkiaRuntimeAssemblies"
          AfterTargets="ResolveAssemblyReferences"
          Condition="'$(_IsCodeBrixMacOSHead)' == 'true'">
    <PropertyGroup>
      <_CbMacSkiaUwp>$(MSBuildThisFileDirectory)..\..\src\Platform.UWP\bin\Platform.Skia\$(Configuration)\net10.0</_CbMacSkiaUwp>
      <_CbMacSkiaComp>$(MSBuildThisFileDirectory)..\..\src\Platform.UI.Composition\bin\Platform.UI.Composition.Skia\$(Configuration)\net10.0</_CbMacSkiaComp>
      <_CbMacSkiaDisp>$(MSBuildThisFileDirectory)..\..\src\Platform.UI.Dispatching\bin\Platform.UI.Dispatching.Skia\$(Configuration)\net10.0</_CbMacSkiaDisp>
    </PropertyGroup>
    <ItemGroup>
      <!-- Drop the .Reference variants resolved for the runtime-replaced assemblies (dll + pdb). -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(FileName)' == 'CodeBrix.Platform' or '%(FileName)' == 'CodeBrix.Platform.UI.Composition' or '%(FileName)' == 'CodeBrix.Platform.UI.Dispatching'" />
      <!-- Add the .Skia variants in their place. -->
      <ReferenceCopyLocalPaths Include="$(_CbMacSkiaUwp)\CodeBrix.Platform.dll" Condition="Exists('$(_CbMacSkiaUwp)\CodeBrix.Platform.dll')" />
      <ReferenceCopyLocalPaths Include="$(_CbMacSkiaUwp)\CodeBrix.Platform.pdb" Condition="Exists('$(_CbMacSkiaUwp)\CodeBrix.Platform.pdb')" />
      <ReferenceCopyLocalPaths Include="$(_CbMacSkiaComp)\CodeBrix.Platform.UI.Composition.dll" Condition="Exists('$(_CbMacSkiaComp)\CodeBrix.Platform.UI.Composition.dll')" />
      <ReferenceCopyLocalPaths Include="$(_CbMacSkiaComp)\CodeBrix.Platform.UI.Composition.pdb" Condition="Exists('$(_CbMacSkiaComp)\CodeBrix.Platform.UI.Composition.pdb')" />
      <ReferenceCopyLocalPaths Include="$(_CbMacSkiaDisp)\CodeBrix.Platform.UI.Dispatching.dll" Condition="Exists('$(_CbMacSkiaDisp)\CodeBrix.Platform.UI.Dispatching.dll')" />
      <ReferenceCopyLocalPaths Include="$(_CbMacSkiaDisp)\CodeBrix.Platform.UI.Dispatching.pdb" Condition="Exists('$(_CbMacSkiaDisp)\CodeBrix.Platform.UI.Dispatching.pdb')" />
    </ItemGroup>
  </Target>

  <!--
    Native macOS dylib copy (from-source / ProjectReference build). The NuGet package ships
    libCodeBrixNativeMac.dylib under runtimes/osx/native, and NuGet's runtime-asset resolution
    copies it into a consuming head's output automatically. We consume the runtime via a project
    reference instead, so nothing copies it: the managed build succeeds but the host crashes at
    launch with DllNotFoundException on libCodeBrixNativeMac.dylib. Copy it from the runtime
    project into this head's output.

    We also strip com.apple.quarantine from the copy. The committed dylib gets that bit stamped on
    it when the repo is cloned through a quarantine-applying git client (e.g. Sourcetree), and
    Gatekeeper then blocks the dlopen ("could not verify ... free of malware"). Removing it is safe
    for a locally-built, ad-hoc-signed binary; `|| true` keeps the build green when it is absent.
  -->
  <Target Name="_CopyCodeBrixNativeMacDylib"
          AfterTargets="Build"
          Condition="'$(_IsCodeBrixMacOSHead)' == 'true' and $([MSBuild]::IsOsPlatform('OSX'))">
    <PropertyGroup>
      <_CodeBrixNativeMacDylib>$(MSBuildThisFileDirectory)..\..\src\Platform.UI.Runtime.Skia.MacOS\runtimes\osx\native\libCodeBrixNativeMac.dylib</_CodeBrixNativeMacDylib>
    </PropertyGroup>
    <Copy SourceFiles="$(_CodeBrixNativeMacDylib)"
          DestinationFolder="$(OutDir)runtimes\osx\native"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_CodeBrixNativeMacDylib)')" />
    <Exec Command="xattr -d com.apple.quarantine &quot;$(OutDir)runtimes/osx/native/libCodeBrixNativeMac.dylib&quot; 2&gt;/dev/null || true"
          Condition="Exists('$(OutDir)runtimes/osx/native/libCodeBrixNativeMac.dylib')" />
  </Target>

</Project>
