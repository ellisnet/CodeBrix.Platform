<Page
    x:Class="PlotterViewDemo.Views.MainPage"
    xmlns="clr-namespace:Microsoft.UI.Xaml.Controls;assembly=CodeBrix.Platform.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:plot="clr-namespace:CodeBrix.Platform.UI.PlotterView;assembly=CodeBrix.Platform.UI.PlotterView"
    xmlns:local="using:PlotterViewDemo.Views"
    FontFamily="{StaticResource RobotoFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Padding="8,8,8,4">
            <ComboBox x:Name="ChartCombo" VerticalAlignment="Center"
                      SelectionChanged="ChartCombo_SelectionChanged">
                <ComboBoxItem Content="Live signal (streaming)" />
                <ComboBoxItem Content="Function series" />
                <ComboBoxItem Content="Scatter" />
                <ComboBoxItem Content="Bar chart" />
                <ComboBoxItem Content="Pie" />
                <ComboBoxItem Content="Heat map" />
            </ComboBox>
            <Button Content="Reset view" Click="ResetView_Click" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="12"
                       Text="Right-drag pans - wheel zooms - middle-drag draws a zoom box - left-click tracks a point - double-middle-click (or A / Home) resets. Touch: one finger pans, two fingers pinch." />
        </StackPanel>

        <!-- The plot. A bounded star cell is the recommended host; the control
             renders, pans, zooms and tracks whatever PlotModel it is given. -->
        <plot:PlotterControl
            x:Name="Plotter"
            Grid.Row="1"
            Margin="8,0,8,0" />

        <!-- Status bar: chart description on the left, live streaming stats on the right -->
        <Grid Grid.Row="2" Padding="8,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis"
                       x:Name="StatusText" Text="PlotterView demo" />
            <TextBlock Grid.Column="1" FontSize="12" x:Name="LiveText" Text="" />
        </Grid>
    </Grid>
</Page>
