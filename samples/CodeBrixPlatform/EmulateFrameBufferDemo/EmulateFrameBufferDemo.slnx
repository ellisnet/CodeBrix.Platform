<Solution>
  <!-- EmulateFrameBufferDemo.slnx
       A CodeBrix.Platform application with Linux heads only (X11, Wayland, Frame Buffer).
       The platform itself is consumed from SOURCE rather than from NuGet, so the sample
       always builds against the working tree. The platform csprojs below are listed in the
       solution deliberately: without them Visual Studio 2026 mis-builds the solution on
       Windows. -->
  <Folder Name="/Platform/" />
  <Folder Name="/Platform/Core/">
    <Project Path="../../../src/Platform.Foundation.Logging/Platform.Foundation.Logging.csproj" />
    <Project Path="../../../src/Platform.Foundation/Platform.Foundation.Reference.csproj" />
    <Project Path="../../../src/Platform.Foundation/Platform.Foundation.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.Composition/Platform.UI.Composition.Reference.csproj" />
    <Project Path="../../../src/Platform.UI.Composition/Platform.UI.Composition.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.Dispatching/Platform.UI.Dispatching.Reference.csproj" />
    <Project Path="../../../src/Platform.UI.Dispatching/Platform.UI.Dispatching.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.Adapter.Microsoft.Extensions.Logging/Platform.UI.Adapter.Microsoft.Extensions.Logging.csproj" />
    <Project Path="../../../src/CodeBrix.Platform.Extensions.Logging/CodeBrix.Platform.Extensions.Logging.csproj" />
  </Folder>
  <Folder Name="/Platform/UWP/">
    <Project Path="../../../src/Platform.UWP/Platform.Reference.csproj" />
    <Project Path="../../../src/Platform.UWP/Platform.Skia.csproj" />
  </Folder>
  <Folder Name="/Platform/UI/">
    <Project Path="../../../src/Platform.UI/Platform.UI.Reference.csproj" />
    <Project Path="../../../src/Platform.UI/Platform.UI.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.Toolkit/Platform.UI.Toolkit.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.FluentTheme/Platform.UI.FluentTheme.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.FluentTheme.v1/Platform.UI.FluentTheme.v1.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.FluentTheme.v2/Platform.UI.FluentTheme.v2.Skia.csproj" />
  </Folder>
  <Folder Name="/Platform/Runtime/">
    <Project Path="../../../src/Platform.UI.Runtime.Skia/Platform.UI.Runtime.Skia.csproj" />
    <Project Path="../../../src/Platform.UI.Runtime.Skia.X11/Platform.UI.Runtime.Skia.X11.csproj" />
    <Project Path="../../../src/Platform.UI.Runtime.Skia.Wayland/Platform.UI.Runtime.Skia.Wayland.csproj" />
    <Project Path="../../../src/Platform.UI.Runtime.Skia.Linux.FrameBuffer/Platform.UI.Runtime.Skia.Linux.FrameBuffer.csproj" />
  </Folder>
  <Folder Name="/Platform/AddIns/">
    <Project Path="../../../src/AddIns/Platform.UI.WebView.Skia/Platform.UI.WebView.Skia.csproj" />
    <Project Path="../../../src/AddIns/Platform.WinUI.Graphics3DGL/Platform.WinUI.Graphics3DGL.csproj" />
    <Project Path="../../../src/AddIns/CodeBrix.Platform.SkiaSharp.Views/CodeBrix.Platform.SkiaSharp.Views.Skia.csproj" />
  </Folder>
  <Folder Name="/Platform/Source Generators/">
    <Project Path="../../../src/SourceGenerators/System.Xaml/Platform.Xaml.csproj" />
    <Project Path="../../../src/SourceGenerators/Platform.UI.SourceGenerators/Platform.UI.SourceGenerators.csproj" />
    <Project Path="../../../src/SourceGenerators/Platform.UI.SourceGenerators.Internal/Platform.UI.SourceGenerators.Internal.csproj" />
    <Project Path="../../../src/SourceGenerators/Platform.UI.Tasks/Platform.UI.Tasks.csproj" />
    <Project Path="../../../src/SourceGenerators/Platform.XamlMerge.Task/Platform.XamlMerge.Task.csproj" />
  </Folder>
  <Folder Name="/Platform/Tools/">
    <Project Path="../../../src/Platform.Analyzers/Platform.Analyzers.csproj" />
  </Folder>
  <Project Path="src/EmulateFrameBufferDemo.UI/EmulateFrameBufferDemo.UI.shproj" />
  <Project Path="src/EmulateFrameBufferDemo.Core/EmulateFrameBufferDemo.Core.csproj" />
  <Project Path="src/EmulateFrameBufferDemo.LinuxX11/EmulateFrameBufferDemo.LinuxX11.csproj" />
  <Project Path="src/EmulateFrameBufferDemo.LinuxWayland/EmulateFrameBufferDemo.LinuxWayland.csproj" />
  <Project Path="src/EmulateFrameBufferDemo.LinuxFrameBuffer/EmulateFrameBufferDemo.LinuxFrameBuffer.csproj" />
</Solution>
