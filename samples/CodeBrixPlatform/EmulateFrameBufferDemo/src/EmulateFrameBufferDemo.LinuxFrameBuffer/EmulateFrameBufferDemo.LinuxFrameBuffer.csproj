<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;HAS_CODEBRIX_WINUI</DefineConstants>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (App.xaml + Views) -->
  <Import Project="..\EmulateFrameBufferDemo.UI\EmulateFrameBufferDemo.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\EmulateFrameBufferDemo.Core\EmulateFrameBufferDemo.Core.csproj" />
  </ItemGroup>

  <!--
    EXACTLY ONE platform head package: the Linux frame-buffer backend (no desktop;
    kiosk/embedded), consumed as a package like any real application. This single
    line is what the CodeBrix.Develop frame-buffer emulator silently swaps for
    CodeBrix.Platform.Runtime.Skia.FrameBuffer.Emulated.ApacheLicenseForever at build
    time when this head is run or debugged in the IDE — the file you are reading is
    never modified.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.Runtime.Skia.FrameBuffer.ApacheLicenseForever" Version="1.0.243.226" />
  </ItemGroup>
</Project>
