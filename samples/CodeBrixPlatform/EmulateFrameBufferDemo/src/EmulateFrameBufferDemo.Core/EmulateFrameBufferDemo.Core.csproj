<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>EmulateFrameBufferDemo</RootNamespace>

    <!-- The GL model viewer passes pointers to Silk-style GL calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The sample's code carries nullable annotations (it was written against
         the platform working tree, which builds nullable-enabled). -->
    <Nullable>enable</Nullable>

    <!-- CodeBrix.Platform needs these defines for its internal conditional compilation. -->
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;HAS_CODEBRIX_WINUI;RESOLVE_SERVICES;SIMPLE_ENUM;SIMPLE_MESSAGING</DefineConstants>
  </PropertyGroup>

  <!-- The bundled CC0 model, copied into every head's output. -->
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />

    <!-- Bundled Open Sans font -->
    <PackageReference Include="CodeBrix.Platform.Fonts.OpenSans.ApacheLicenseForever" Version="1.0.181.655" />

    <!-- The drawing pane: DrawingCanvas plus the drawing model behind it. A different repo,
         so always a package reference. -->
    <PackageReference Include="CodeBrix.Imaging.Drawing.ApacheLicenseForever" Version="1.0.196.349" />

    <!-- glTF loading for the 3D pane's bundled model. -->
    <PackageReference Include="SharpGLTF.Runtime" Version="1.0.6" />
  </ItemGroup>

  <!--
    The CodeBrix.Platform framework + add-ins, consumed as PACKAGES from nuget.org — the
    same shape as a real application, which is the point of this sample: it is the
    end-to-end test rig for the CodeBrix.Develop frame-buffer emulator, and the emulator's
    silent head swap exists for package-consuming apps. The family packages are pinned to
    the published version; bump them together when moving to a newer family release.
      * WebView (WPE WebKit, offscreen): requires the system WPE WebKit engine at run time:
        sudo apt install libwpewebkit-2.0-1 libwpebackend-fdo-1.0-1 libwpe-1.0-1
      * Graphics3DGL: the GLCanvasElement the 3D pane draws into.
      * SkiaSharp.Views: SKXamlCanvas, which CodeBrix.Imaging.Drawing's DrawingCanvas
        derives from (versioned to the SkiaSharp release it vendors, not the family version).
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.205.475" />
    <PackageReference Include="CodeBrix.Platform.WebView.ApacheLicenseForever" Version="1.0.205.475" />
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.205.475" />
    <PackageReference Include="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" Version="4.150.1" />
  </ItemGroup>
</Project>
