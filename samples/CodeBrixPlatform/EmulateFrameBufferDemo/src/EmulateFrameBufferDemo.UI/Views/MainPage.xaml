<Page
    x:Class="EmulateFrameBufferDemo.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmulateFrameBufferDemo.ViewModels"
    xmlns:render="using:EmulateFrameBufferDemo.Rendering"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    FontFamily="{StaticResource OpenSansFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <!-- The button strip, then the three panes filling the rest. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Buttons: each one drives one of the panes below, so a tap that does
             something visible is always one click away. -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Spin / Pause" Click="OnToggleSpin" />
                <Button Content="Reset Model" Click="OnResetModel" />
                <Button Content="Wikipedia Home" Click="OnBrowserHome" />
                <Button Content="Clear Drawing" Click="OnClearDrawing" />
                <Button Content="Undo Stroke" Click="OnUndoStroke" />
                <Button x:Name="ColorButton" Content="Brush Colour" Click="OnCycleBrushColor" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: OpenGL, through the Graphics3DGL add-in. -->
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#40808080" CornerRadius="4">
                <Grid>
                    <render:ModelViewerCanvas x:Name="ModelView" />
                    <TextBlock Text="OpenGL" Opacity="0.65" FontSize="12" Margin="6"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Centre: the WebView add-in (offscreen WPE WebKit on Linux). -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#40808080" CornerRadius="4">
                <Grid>
                    <WebView2 x:Name="Browser" />
                    <TextBlock Text="WebView" Opacity="0.65" FontSize="12" Margin="6"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Right: a Skia drawing surface driven by CodeBrix.Imaging.Drawing. -->
            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#40808080" CornerRadius="4">
                <Grid Background="#FFFFFFFF">
                    <skia:SKXamlCanvas x:Name="Sketch"
                                       PaintSurface="OnSketchPaintSurface"
                                       PointerPressed="OnSketchPointerPressed"
                                       PointerMoved="OnSketchPointerMoved"
                                       PointerReleased="OnSketchPointerReleased"
                                       PointerCanceled="OnSketchPointerCanceled"
                                       PointerCaptureLost="OnSketchPointerCanceled" />
                    <TextBlock Text="Draw here" Opacity="0.45" FontSize="12" Margin="6"
                               Foreground="#FF202020"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
