<Page x:Class="FlexPanelDemo.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:flex="using:CodeBrix.Platform.UI.FlexPanel"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      FontFamily="{StaticResource OpenSansFont}">

  <ScrollViewer>
    <StackPanel Padding="16" Spacing="12">

      <TextBlock Text="FlexPanel Demo" FontSize="26" FontWeight="Bold" />
      <TextBlock TextWrapping="Wrap"
                 Text="A CSS flexbox-style layout panel for CodeBrix.Platform. Change the panel properties below and the playground re-lays-out live. Children 3, 4, 6 and 7 carry the attached properties FlexPanel.Order, FlexPanel.Grow, FlexPanel.AlignSelf and FlexPanel.Basis; child 8 is a nested FlexPanel." />

      <!-- Panel property controls (the playground re-lays-out on every change) -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="Direction" FontSize="12" />
          <ComboBox x:Name="DirectionCombo" Width="150" SelectionChanged="OnPanelPropertyChanged" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="Wrap" FontSize="12" />
          <ComboBox x:Name="WrapCombo" Width="120" SelectionChanged="OnPanelPropertyChanged" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="JustifyContent" FontSize="12" />
          <ComboBox x:Name="JustifyCombo" Width="150" SelectionChanged="OnPanelPropertyChanged" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="AlignItems" FontSize="12" />
          <ComboBox x:Name="AlignItemsCombo" Width="120" SelectionChanged="OnPanelPropertyChanged" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="AlignContent" FontSize="12" />
          <ComboBox x:Name="AlignContentCombo" Width="150" SelectionChanged="OnPanelPropertyChanged" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="Child 5" FontSize="12" />
          <CheckBox x:Name="ShowChild5Check" Content="Visible" IsChecked="True"
                    Checked="OnShowChild5Changed" Unchecked="OnShowChild5Changed" />
        </StackPanel>
      </StackPanel>

      <!-- The interactive playground -->
      <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="380">
        <flex:FlexPanel x:Name="Playground" Direction="Row" Wrap="Wrap" Padding="8">

          <Border Width="110" Height="60" Margin="4" Background="#E57373" CornerRadius="4">
            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <Border Width="150" Height="90" Margin="4" Background="#FFB74D" CornerRadius="4">
            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <Border Width="120" Height="55" Margin="4" Background="#FFF176" CornerRadius="4"
                  flex:FlexPanel.Order="-1">
            <TextBlock Text="3 · Order -1" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <!-- No explicit Width: an explicit Width would win over the grown arrange slot (standard
               WinUI behavior), hiding the Grow effect. Without one, the child fills its slot. -->
          <Border Height="70" Margin="4" Background="#81C784" CornerRadius="4"
                  flex:FlexPanel.Grow="1">
            <TextBlock Text="4 · Grow 1" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <Border x:Name="Child5" Width="110" Height="60" Margin="4" Background="#64B5F6" CornerRadius="4">
            <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <Border Width="100" Height="95" Margin="4" Background="#BA68C8" CornerRadius="4"
                  flex:FlexPanel.AlignSelf="End">
            <TextBlock Text="6 · AlignSelf End" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <Border Height="60" Margin="4" Background="#4DB6AC" CornerRadius="4"
                  flex:FlexPanel.Basis="25%">
            <TextBlock Text="7 · Basis 25%" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <Border Width="140" Height="100" Margin="4" Background="#90A4AE" CornerRadius="4" Padding="4">
            <flex:FlexPanel Direction="Column" JustifyContent="SpaceEvenly" AlignItems="Center">
              <TextBlock Text="8 · nested" />
              <Border Width="90" Height="22" Background="#CFD8DC" CornerRadius="11" />
              <Border Width="60" Height="22" Background="#CFD8DC" CornerRadius="11" />
            </flex:FlexPanel>
          </Border>

        </flex:FlexPanel>
      </Border>

      <!-- Fixed examples -->
      <TextBlock Text="Grow and Basis (children with no Height stretch to the line)" FontWeight="SemiBold" />
      <flex:FlexPanel Direction="Row" Height="56">
        <Border Width="100" Background="#E57373">
          <TextBlock Text="fixed 100" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Background="#FFB74D" flex:FlexPanel.Grow="1">
          <TextBlock Text="Grow 1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Background="#81C784" flex:FlexPanel.Grow="2">
          <TextBlock Text="Grow 2" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Background="#64B5F6" flex:FlexPanel.Basis="20%">
          <TextBlock Text="Basis 20%" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </flex:FlexPanel>

      <TextBlock Text="A navigation bar: JustifyContent SpaceBetween + AlignItems Center" FontWeight="SemiBold" />
      <Border Background="#ECEFF1" CornerRadius="4">
        <flex:FlexPanel Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center"
                        Height="64" Padding="12">
          <TextBlock Text="Logo" FontSize="20" FontWeight="Bold" Foreground="#37474F" />
          <TextBlock Text="Home" Foreground="#37474F" />
          <TextBlock Text="Products" Foreground="#37474F" />
          <TextBlock Text="About" Foreground="#37474F" />
          <Button Content="Sign in" />
        </flex:FlexPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
